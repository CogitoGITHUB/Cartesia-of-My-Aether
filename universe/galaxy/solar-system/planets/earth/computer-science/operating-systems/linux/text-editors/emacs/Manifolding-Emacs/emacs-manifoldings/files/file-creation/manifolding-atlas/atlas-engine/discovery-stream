#+begin_src emacs-lisp
(require 'cl-lib)
(require 'seq)

(defvar my/atlas-discovery-history nil
  "AIU ids shown, newest first (max 100).")

(defvar my/atlas-discovery-count 10
  "Cards per discovery batch.")

(defun my/atlas-discovery-sample (&optional n)
  "N random AIUs (default `my/atlas-discovery-count')."
  (let ((notes (ignore-errors (manifolding-atlas-db-query))))
    (seq-take (seq-shuffle notes) (or n my/atlas-discovery-count))))

(defun my/atlas-discovery-note-text (note)
  "Title plus up to 1500 chars of body for AIU."
  (let* ((title (or (ignore-errors (manifolding-atlas-note-title note)) "?"))
         (path (ignore-errors (manifolding-atlas-note-path note)))
         (body (when (and path (file-exists-p path))
                 (with-temp-buffer
                   (insert-file-contents path nil 0 8192)
                   (buffer-string)))))
    (format "%s\n%s" title (substring (or body "") 0 (min 1500 (length (or body "")))))))

(defun my/atlas-discovery ()
  "Show a batch of random AIU cards."
  (interactive)
  (let ((buf (get-buffer-create "*Atlas Discovery*"))
        (cards (my/atlas-discovery-sample)))
    (dolist (n cards)
      (let ((id (ignore-errors (manifolding-atlas-note-id n))))
        (when id (push id my/atlas-discovery-history))))
    (setq my/atlas-discovery-history (seq-take my/atlas-discovery-history 100))
    (with-current-buffer buf
      (let ((inhibit-read-only t))
        (erase-buffer)
        (dolist (n cards)
          (let ((note n))
            (insert-text-button
             (or (ignore-errors (manifolding-atlas-note-title note)) "?")
             'action (lambda (_) (ignore-errors (manifolding-atlas-visit note))))
            (insert "\n" (my/atlas-discovery-note-text note) "\n\n---\n\n"))))
      (special-mode)
      (display-buffer buf))))
#+end_src
