** Entry and exit
Enter automatically with the map mode; leave explicitly. Neither
side depends on the other: every call is guarded, so the keyboard
works with the unit absent and the unit works with the keyboard
absent.
#+begin_src emacs-lisp
(defun my/org-mindmap-quit-state ()
  "Leave the org-mindmap state back to normal."
  (interactive)
  (when (fboundp 'manifolding-keyboard-set-state)
    (manifolding-keyboard-set-state "normal")))

(defun my/org-mindmap--auto-enter ()
  "Enter the org-mindmap state when the map mode turns on."
  (when (and (boundp 'org-mindmap-mode) org-mindmap-mode
             (fboundp 'manifolding-keyboard-set-state))
    (manifolding-keyboard-set-state "org-mindmap")))

(add-hook 'org-mindmap-mode-hook #'my/org-mindmap--auto-enter)
#+end_src
