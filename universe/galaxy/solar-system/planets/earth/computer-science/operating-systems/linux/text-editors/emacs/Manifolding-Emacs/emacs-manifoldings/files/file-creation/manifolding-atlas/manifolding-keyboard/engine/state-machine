** Buffer initialization & setup
#+begin_src emacs-lisp
(manifolding-keyboard-define-local-var manifolding-keyboard--initialized nil
  "Non-nil if this buffer is initialized by manifolding-keyboard.")

(defun manifolding-keyboard-initialize (&optional force)
  "Initialize current buffer with init manifolding-keyboard state."
  (when (or force (not manifolding-keyboard--initialized))
    (setq manifolding-keyboard--initialized t)
    (unless (minibufferp)
      (if manifolding-keyboard-init-state-fn (manifolding-keyboard-set-init-state)))))

(defun manifolding-keyboard-initialize-all-buffers ()
  "Initialize all existing buffers."
  (dolist (buf (buffer-list))
    (with-current-buffer buf (manifolding-keyboard-initialize))))

(defun manifolding-keyboard-setup ()
  "Set up manifolding-keyboard for existing and future buffers."
  (add-hook 'after-change-major-mode-hook
            (lambda ()
              (setq manifolding-keyboard--initialized nil)
              (manifolding-keyboard-initialize)))
  (add-hook 'buffer-list-update-hook
            (lambda () (manifolding-keyboard-initialize-all-buffers)))
  (manifolding-keyboard-initialize-all-buffers))

(defun manifolding-keyboard-enable-substate-on-state-change (substate &rest body)
  "Enable SUBSTATE under conditions specified in BODY."
  (declare (indent defun))
  (let ((states (plist-get body :states))
        (major (plist-get body :major))
        (minor (plist-get body :minor))
        (pred (plist-get body :pred))
        (check-minor (lambda (mode)
                       (and (boundp mode) (symbol-value mode)))))
    (add-variable-watcher
     'manifolding-keyboard-state
     (lambda (_ new-val _ _)
       (funcall (manifolding-keyboard-get-substate-mode substate)
                (if (and (or (not major) (memq major-mode major))
                         (or (not minor) (memq t (mapcar check-minor minor)))
                         (or (not pred) (funcall pred))
                         (or (not states) (member new-val states)))
                    1 -1))))))

(provide 'manifolding-keyboard)
#+end_src

