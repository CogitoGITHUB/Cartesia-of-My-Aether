** Atlas integration
AIUs are org buffers, so AIU Subnet regions work in them
natively. This block is the only atlas-specific code: a one-key
block inserter (bound in the AIU Subnet keyboard state) plus
auto-activation of `org-mindmap-mode' inside AIU Subnet regions, so
the state drives and the package follows.
#+begin_src emacs-lisp
(defun my/atlas-mindmap-insert-block ()
  "Insert an empty mindmap region for the current subtree.
C-c C-c inside redraws; the AIU Subnet keyboard state drives after."
  (interactive)
  (insert "#+begin_mindmap\n\n#+end_mindmap\n")
  (forward-line -1))

(defun my/atlas-mindmap--maybe-activate ()
  "Enable `org-mindmap-mode' when point sits in an AIU Subnet region."
  (when (and (derived-mode-p 'org-mode)
             (fboundp 'org-mindmap-parser-region-active-p)
             (org-mindmap-parser-region-active-p))
    (org-mindmap-mode 1)))

(add-hook 'post-command-hook #'my/atlas-mindmap--maybe-activate)
