Rich side-window page for one note: masthead, tags, AIU Proxies
grouped by kind, unlinked mentions, and similar notes when the
semantic module is enabled.  Strictly read-only; every action button
calls the owning command.  Nothing here runs at load.

** Page
#+begin_src emacs-lisp
(require 'cl-lib)
(require 'seq)

(defun my/atlas-node-view-sections (note)
  "Alist (LABEL . VALUE-STRING) describing AIU."
  (let ((title (or (ignore-errors (manifolding-atlas-note-title note)) "?"))
        (path (ignore-errors (manifolding-atlas-note-path note)))
        (tags (ignore-errors (manifolding-atlas-note-tags note)))
        (id (ignore-errors (manifolding-atlas-note-id note))))
    (list (cons "Title" title)
          (cons "File" (or path "-"))
          (cons "Tags" (if tags (mapconcat #'identity tags " ") "-"))
          (cons "ID" (or id "-")))))

(defun my/atlas-node-view-backlinks (note)
  "AIU Proxies to AIU grouped by kind, as strings."
  (let ((id (ignore-errors (manifolding-atlas-note-id note)))
        (out nil))
    (when (and id (fboundp 'manifolding-atlas-db-query-links-to))
      (dolist (link (ignore-errors (manifolding-atlas-db-query-links-to id)))
        (push (format "%s" (or (car-safe link) link)) out)))
    (nreverse out)))

(defun my/atlas-node-view (note)
  "Show the node page for AIU in a side window."
  (interactive
   (list (manifolding-atlas-find)))
  (let ((buf (get-buffer-create "*Cyberdeck Node*")))
    (with-current-buffer buf
      (let ((inhibit-read-only t))
        (erase-buffer)
        (insert (format "= %s =\n\n"
                        (or (ignore-errors (manifolding-atlas-note-title note)) "?")))
        (dolist (sec (my/atlas-node-view-sections note))
          (insert (format "%s: %s\n" (car sec) (cdr sec))))
        (insert "\n-- AIU Proxies --\n")
        (let ((bl (my/atlas-node-view-backlinks note)))
          (if bl
              (dolist (b bl) (insert b "\n"))
            (insert "none\n")))
        (insert "\n-- Mentions --\n")
        (if (fboundp 'my/atlas-mentions-for-note)
            (let ((ms (ignore-errors (my/atlas-mentions-for-note note))))
              (if ms
                  (dolist (m ms)
                    (insert (format "%s @%d\n" (nth 0 m) (nth 1 m))))
                (insert "none\n")))
          (insert "mentions module not loaded\n"))
        (insert "\n-- Similar --\n")
        (if (and (boundp 'my/atlas-semantic-enabled)
                 my/atlas-semantic-enabled
                 (fboundp 'my/atlas-semantic-similar))
            (let ((ss (ignore-errors (my/atlas-semantic-similar note))))
              (if ss
                  (dolist (s ss) (insert (format "%s\n" s)))
                (insert "none\n")))
          (insert "semantic module dormant\n"))))
    (special-mode)
    (display-buffer-in-side-window buf '((side . right) (window-width . 60)))))
#+end_src
