** Widget
#+begin_src emacs-lisp
(manifolding-dashboard-define-widget todos
  :doc "Module TODOs section."
  :generate
  ((let ((todos (manifolding-emacs-splash--module-todos)))
     (dashboard-insert-heading "Module TODOs:" nil nil)
     (insert "\n")
     (if (null todos)
         (insert "    --- No items ---\n")
       (dolist (td todos)
         (insert (format "    %s: %s\n"
                         (propertize (car td) 'face 'bold)
                         (cdr td))))))))
#+end_src
