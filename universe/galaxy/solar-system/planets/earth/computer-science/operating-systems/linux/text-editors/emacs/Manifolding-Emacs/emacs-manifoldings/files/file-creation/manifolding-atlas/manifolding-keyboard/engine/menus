(defun my/menus--ghostel-or-msg ()
  "Open ghostel if available, else fallback to vterm/ansi-term."
  (interactive)
  (cond ((fboundp 'ghostel) (call-interactively #'ghostel))
        ((fboundp 'vterm) (call-interactively #'vterm))
        ((fboundp 'ansi-term) (ansi-term (or (getenv "SHELL") "/bin/bash")))
        (t (user-error "no terminal available (ghostel disabled, vterm not installed)"))))

(unless (fboundp 'my/manifolding-atlas-quick-captures)
  (defun my/manifolding-atlas-quick-captures ()
    "Stale quick-captures entry: dispatch to real fast-captures."
    (interactive)
    (cond ((fboundp 'my/manifolding-atlas-quick-journal)
           (call-interactively #'my/manifolding-atlas-quick-journal))
          ((fboundp 'my/manifolding-atlas-quick-todo)
           (call-interactively #'my/manifolding-atlas-quick-todo))
          ((fboundp 'my/manifolding-atlas-quick-observations)
           (call-interactively #'my/manifolding-atlas-quick-observations))
          (t (user-error "quick captures not loaded (atlas fast-captures not available)")))))

(defun my/menus--digraphs-or-msg ()
  "Show digraphs if evil present, else fallback."
  (interactive)
  (cond ((fboundp 'evil-show-digraphs) (call-interactively #'evil-show-digraphs))
        ((fboundp 'list-digraphs) (call-interactively #'list-digraphs))
        (t (user-error "digraphs not available (evil not loaded)"))))

(transient-define-prefix my/main-hydra/body ()
  "Main menu. Submenus derived from the leader map + hydra registry."
  ["Leaders" :class transient-column :setup-children
   (lambda (_) (my/menus-leader-suffixes))]
  ["Quick Access" :class transient-column
   ("o" "open link" org-open-at-point)
   ("v" "manifolding-atlas" my/manifolding-atlas-hydra/body)
   ("T" "terminal" my/menus--ghostel-or-msg)
   ("z" "fast capture" my/manifolding-atlas-quick-captures)
   ("/" "digraphs" my/menus--digraphs-or-msg)])
