The loader's boot stats, as a dashboard section. Reads only from the
loader's own helper functions (defined in manifolding-emacs.org,
which always evaluates before modules do).

** Widget
#+begin_src emacs-lisp
(manifolding-dashboard-define-widget status
  :doc "Loader boot stats as a dashboard section."
  :generate
  ((let* ((errors (length (manifolding-emacs-errors-list)))
          (warnings (length (manifolding-emacs-warnings-list)))
          (notes (manifolding-emacs-splash--notes-count))
          (missing (manifolding-emacs-splash--missing-prompts-count))
          (git-line (manifolding-emacs-splash--vault-git-info))
          (boot (or manifolding-emacs--last-boot-seconds
                    (car (last (manifolding-emacs-splash--read-history))))))
     (dashboard-insert-heading "Cyberdeck:" nil nil)
     (insert "\n")
     (insert (format "    boot %s %s\n"
                     (if boot (format "%.1fs" boot) "?")
                     (manifolding-emacs-splash--sparkline)))
     (insert (format "    errors %d · warnings %d\n" errors warnings))
     (insert (format "    vault notes: %d · missing prompts: %d\n"
                     notes missing))
     (when git-line
       (insert (format "    git: %s\n" git-line))))))
#+end_src
