#+title:      Tag Manager

* Tag Manager :EMACS_MECHANISM:
:PROPERTIES:
:ID:       970ded1e-a3e5-4977-a393-55b80ea40873
:END:

Global view over tags: counts from note tags plus the inline-hashtag
sidecar, rename/delete with preview-then-apply (never blind rewrite),
and orphan cleanup.  Org headline tags and inline `#tags` are rewritten
by line-aware rules; drawers and bodies are never touched.  Nothing
here runs at load.

** Census
#+begin_src emacs-lisp
(require 'cl-lib)
(require 'seq)

(defun my/atlas-tags-census ()
  "Alist (TAG COUNT SOURCES) over note tags and inline hashtags.
SOURCES is a subset of (note inline)."
  (let ((counts (make-hash-table :test 'equal))
        (srcs (make-hash-table :test 'equal)))
    (dolist (n (ignore-errors (manifolding-atlas-db-query)))
      (dolist (tag (ignore-errors (manifolding-atlas-note-tags n)))
        (when (stringp tag)
          (puthash tag (1+ (gethash tag counts 0)) counts)
          (puthash tag (cl-adjoin 'note (gethash tag srcs)) srcs))))
    (when (boundp 'my/atlas-hashtag-index)
      (maphash (lambda (tag files)
                 (puthash tag (+ (gethash tag counts 0) (length files)) counts)
                 (puthash tag (cl-adjoin 'inline (gethash tag srcs)) srcs))
               my/atlas-hashtag-index))
    (let (out)
      (maphash (lambda (tag count)
                 (push (list tag count (gethash tag srcs)) out))
               counts)
      (sort out (lambda (a b) (> (nth 1 a) (nth 1 b)))))))
#+end_src

** Rewrite engine
#+begin_src emacs-lisp
(defun my/atlas-tag--rewrite-run (line old new)
  "Replace tag OLD with NEW inside a headline tag run; tidy on delete."
  (let ((out (replace-regexp-in-string
              (concat ":" (regexp-quote old) "\\(:\\|$\\)")
              (if (string-empty-p new) "\\1" (concat ":" new "\\1"))
              line)))
    (when (string-empty-p new)
      (setq out (replace-regexp-in-string "::" ":" out))
      (setq out (replace-regexp-in-string "[ \t]+:[ \t]*$" "" out)))
    out))
(defun my/atlas-tag-occurrences (old)
  "List of (FILE LINE OLD-TEXT NEW-TEXT-FN) for tag OLD.
NEW-TEXT-FN takes the replacement tag and returns the new line text."
  (let ((out nil)
        (root (ignore-errors (my/manifolding-atlas-root-dir))))
    (when root
      (dolist (f (directory-files-recursively root "\\.org\\'"))
        (unless (or (string-match-p "/\\.git/" f) (string-match-p "/admin/" f))
          (with-temp-buffer
            (insert-file-contents f)
            (goto-char (point-min))
            (let ((ln 0))
              (while (not (eobp))
                (setq ln (1+ ln))
                (let ((line (buffer-substring-no-properties
                             (line-beginning-position) (line-end-position))))
                  (cond
                   ((string-match (format "^\\*+ .*\\(:[A-Za-z0-9_@]+\\(?::[A-Za-z0-9_@]+\\)*:\\)[ \t]*$" line))
                    (let ((run (match-string 1 line)))
                      (when (member old (split-string (substring run 1 -1) ":"))
                        (push (list f ln line
                                    (lambda (new)
                                      (my/atlas-tag--rewrite-run line old new)))
                              out))))
                   ((string-match "^[ \t]*#\\+FILETAGS:" line)
                    (when (member old (split-string line "[: \t]+" t))
                      (push (list f ln line
                                  (lambda (new)
                                    (replace-regexp-in-string
                                     (regexp-quote old) new line t t)))
                            out)))
                   (t
                    (let ((pos 0) (found nil))
                      (while (string-match (concat "\\(^\\|[ \t\n]\\)#"
                                                          (regexp-quote old)
                                                          "\\([^A-Za-z0-9_@/]\\|$\\)")
                                                  line pos)
                        (setq found t
                              pos (match-end 0)))
                      (when found
                        (push (list f ln line
                                    (lambda (new)
                                      (replace-regexp-in-string
                                       (concat "\\(^\\|[ \t\n]\\)#"
                                               (regexp-quote old)
                                               "\\([^A-Za-z0-9_@/]\\|$\\)")
                                       (if (string-empty-p new)
                                           "\\1\\2"
                                         (concat "\\1#" new "\\2"))
                                       line)))
                              out)))))))
                (forward-line 1)))))))
    (nreverse out)))

(defun my/atlas-tag-apply (occurrences new)
  "Apply OCCURRENCES with replacement tag NEW (empty deletes).
Edits back to front per file.  Returns files changed."
  (let ((by-file (make-hash-table :test 'equal)))
    (dolist (o occurrences)
      (push o (gethash (nth 0 o) by-file)))
    (let (changed)
      (maphash
       (lambda (f os)
         (with-current-buffer (find-file-noselect f)
           (save-excursion
             (dolist (o (sort (copy-sequence os)
                              (lambda (a b) (> (nth 1 a) (nth 1 b)))))
               (goto-char (point-min))
               (forward-line (1- (nth 1 o)))
               (let ((cur (buffer-substring-no-properties
                           (line-beginning-position) (line-end-position))))
                 (when (string= cur (nth 2 o))
                   (delete-region (line-beginning-position) (line-end-position))
                   (insert (funcall (nth 3 o) new))))))
           (save-buffer)
           (push f changed)))
       by-file)
      changed)))

(defun my/atlas-tag-preview (occurrences new)
  "Show OCCURRENCES with replacement NEW in a preview buffer."
  (let ((buf (get-buffer-create "*Atlas Tag Preview*")))
    (with-current-buffer buf
      (let ((inhibit-read-only t))
        (erase-buffer)
        (insert (format "%d occurrence(s) -> '%s'\n\n" (length occurrences) new))
        (dolist (o occurrences)
          (insert (format "%s:%d\n- %s\n+ %s\n\n"
                          (nth 0 o) (nth 1 o) (nth 2 o)
                          (funcall (nth 3 o) new))))))
    (display-buffer buf)))
