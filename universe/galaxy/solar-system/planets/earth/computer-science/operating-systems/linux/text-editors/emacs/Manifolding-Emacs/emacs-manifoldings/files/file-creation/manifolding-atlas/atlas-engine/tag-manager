(define-derived-mode my/atlas-tag-manager-mode tabulated-list-mode
  "Atlas-Tags"
  "Tag census with counts and sources."
  (setq tabulated-list-format [("Tag" 30 t) ("Count" 8 t) ("Sources" 16 t)])
  (setq tabulated-list-sort-key (cons "Count" nil))
  (tabulated-list-init-header))

(defun my/atlas-tag-manager ()
  "Open the tag manager."
  (interactive)
  (let ((buf (get-buffer-create "*Atlas Tags*")))
    (with-current-buffer buf
      (my/atlas-tag-manager-mode)
      (setq tabulated-list-entries
            (mapcar (lambda (row)
                      (list (nth 0 row)
                            (vector (nth 0 row)
                                    (format "%d" (nth 1 row))
                                    (mapconcat #'symbol-name (nth 2 row) ","))))
                    (my/atlas-tags-census)))
      (tabulated-list-print t))
    (display-buffer buf)))
