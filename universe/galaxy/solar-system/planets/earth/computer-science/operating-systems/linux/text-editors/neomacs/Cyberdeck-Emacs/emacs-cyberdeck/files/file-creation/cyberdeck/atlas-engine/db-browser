** Browse command
#+begin_src emacs-lisp
(defvar cyberdeck-db-location)

(defun my/cyberdeck-browse-db ()
  "Open a clutch query console on the Cyberdeck substrate database."
  (interactive)
  (require 'clutch)
  (unless (and (boundp 'cyberdeck-db-location)
               cyberdeck-db-location
               (file-readable-p cyberdeck-db-location))
    (user-error "Cyberdeck database not ready: %s" cyberdeck-db-location))
  (clutch-query-sqlite-file cyberdeck-db-location))
#+end_src
