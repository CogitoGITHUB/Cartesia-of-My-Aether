A when the atlas DB is reachable, C appended while clocking. Cached
on a minute timer plus after-save (never a syscall per render).
#+begin_src emacs-lisp
(defvar manifolding-modeline--atlas-cache "A")

(defun manifolding-modeline--atlas-refresh ()
  "Recompute the cached atlas letters."
  (setq manifolding-modeline--atlas-cache
        (condition-case nil
            (concat
             (if (and (boundp 'manifolding-atlas-db-location)
                      (stringp manifolding-atlas-db-location)
                      (file-exists-p manifolding-atlas-db-location))
                 "A"
               (propertize "A" 'face 'manifolding-modeline-error-face))
             (if (and (fboundp 'org-clocking-p) (org-clocking-p))
                 (propertize "C" 'face 'manifolding-modeline-ok-face)
               ""))
          (error "A")))
  nil)

(defvar manifolding-modeline--atlas-timer nil)

(unless (timerp manifolding-modeline--atlas-timer)
  (setq manifolding-modeline--atlas-timer
        (run-with-timer 0 60 #'manifolding-modeline--atlas-refresh)))

(unless (member #'manifolding-modeline--atlas-refresh after-save-hook)
  (add-hook 'after-save-hook #'manifolding-modeline--atlas-refresh))

(manifolding-modeline--atlas-refresh)

(manifolding-modeline-define-segment atlas
  manifolding-modeline--atlas-cache)
#+end_src
