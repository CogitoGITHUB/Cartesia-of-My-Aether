(defun my/manifolding-atlas-emacs-mechanism--ensure-mm-row (id parent-id)
  "Insert mm-nodes root row for ID (or under PARENT-ID) when missing."
  (when (and id (fboundp 'manifolding-atlas-db)
             (not (my/manifolding-atlas-emacs-mechanism--indexed-p id)))
    (condition-case err
        (let* ((db (manifolding-atlas-db))
               (depth (if parent-id 1 0))
               (maxk (or (caar (emacsql db [:select [(funcall max order-key)]
                                               :from mm-nodes])) 0.0)))
          (emacsql db [:insert :into mm-nodes :values $v1]
                   (vector id parent-id (+ maxk 1.0) "file" depth)))
      (error (message "auto-atlas mm row failed [%s]: %s"
                      id (error-message-string err))))))
#+end_src

** Auto run once
#+begin_src emacs-lisp
(defvar my/manifolding-atlas-emacs-mechanism--auto-ran nil
  "Session guard: auto-run fires once behind the db-open timer.")

(defun my/manifolding-atlas-emacs-mechanism-auto-run-once (&optional force)
  "Convert all tagged-but-incomplete files. Timer-safe, idempotent."
  (when (or force (not my/manifolding-atlas-emacs-mechanism--auto-ran))
    (setq my/manifolding-atlas-emacs-mechanism--auto-ran t)
    (let ((files (my/manifolding-atlas-emacs-mechanism-auto-scan))
          (done 0) (failed nil))
      (dolist (f files)
        (condition-case err
            (when (my/manifolding-atlas-emacs-mechanism-auto-convert-file f)
              (setq done (1+ done)))
          (error (push (cons f (error-message-string err)) failed))))
      (message "auto-atlas: %d converted, %d failed" done (length failed))
      (dolist (fl failed) (message "auto-atlas FAIL %s: %s" (car fl) (cdr fl)))
      done)))
#+end_src

