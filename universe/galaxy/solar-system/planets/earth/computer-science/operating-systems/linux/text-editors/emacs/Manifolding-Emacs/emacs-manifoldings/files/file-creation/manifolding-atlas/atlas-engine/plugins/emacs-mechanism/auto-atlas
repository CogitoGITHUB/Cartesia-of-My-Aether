(defun my/manifolding-atlas-emacs-mechanism--indexed-p (id)
  "Non-nil when ID has both notes and mm-nodes rows. Nil-safe without DB."
  (and id (fboundp 'manifolding-atlas-db)
       (condition-case nil
           (let ((db (manifolding-atlas-db)))
             (and (car (emacsql db [:select [id] :from notes :where (= id $s1)] id))
                  (car (emacsql db [:select [note-id] :from mm-nodes :where (= note-id $s1)] id))))
         (error nil))))
#+end_src

** Auto convert file
#+begin_src emacs-lisp
(defun my/manifolding-atlas-emacs-mechanism-auto-convert-file (file &optional parent-id)
  "Make FILE a real Atlas file: ID drawer, index rows, mm row. Returns ID."
  (require 'org-id nil t)
  (let* ((parsed (manifolding-emacs-file-first-headline file))
         (id (or (nth 2 parsed)
                 (with-current-buffer (find-file-noselect file)
                   (goto-char (point-min))
                   (when (re-search-forward "^\\*+ " nil t)
                     (let ((new (org-id-uuid)))
                       (forward-line 1)
                       (insert ":PROPERTIES:\n:ID:       " new "\n:END:\n")
                       (save-buffer) new))))))
    (unless id (error "No headline to anchor :ID: in %s" file))
    (when (fboundp 'manifolding-atlas-db-update-file)
      (manifolding-atlas-db-update-file file))
    (my/manifolding-atlas-emacs-mechanism--ensure-mm-row id parent-id)
    id))
#+end_src

