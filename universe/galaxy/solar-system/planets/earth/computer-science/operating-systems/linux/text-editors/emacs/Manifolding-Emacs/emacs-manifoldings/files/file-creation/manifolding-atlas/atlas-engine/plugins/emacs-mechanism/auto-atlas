(defun my/manifolding-atlas-emacs-mechanism-auto-scan ()
  "Tagged files that are not full Atlas files yet. Whole vault minus WIP."
  (when (fboundp 'my/manifolding-atlas-root-dir)
    (let ((root (my/manifolding-atlas-root-dir)) out)
      (dolist (f (directory-files-recursively root "[^./]+$"))
        (unless (or (string-match-p "/\\.git/" f)
                    (string-match-p "/WIP-DONT-TOUCH/" f))
          (when (my/manifolding-atlas-emacs-mechanism--needs-convert-p f)
            (push f out))))
      (nreverse out))))
#+end_src

** Needs convert predicate
#+begin_src emacs-lisp
(defun my/manifolding-atlas-emacs-mechanism--needs-convert-p (file)
  "Non-nil when FILE is tagged :EMACS_MECHANISM: but lacks ID or DB rows."
  (and (fboundp 'manifolding-emacs-file-first-headline)
       (let ((parsed (manifolding-emacs-file-first-headline file)))
         (when parsed
           (let ((tags (nth 1 parsed)) (id (nth 2 parsed)))
             (and tags (member "EMACS_MECHANISM"
                               (split-string (string-trim tags ":" ":") ":" t))
                  (or (null id) (not (my/manifolding-atlas-emacs-mechanism--indexed-p id)))))))))
#+end_src

