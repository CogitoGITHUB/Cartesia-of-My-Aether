(defun my/manifolding-atlas-blueprint-add (title)
  "Create a new prompt blueprint for TITLE beside existing blueprints.
Derives KEY (upper, underscores), errors loudly on empty KEY or
existing KEY. Registers the prompt when the capture finalizes."
  (interactive (list (read-string "Blueprint title: ")))
  (let* ((key (replace-regexp-in-string
               "_+$" ""
               (replace-regexp-in-string "[^A-Z0-9]+" "_" (upcase title)))))
    (when (string-empty-p key)
      (user-error "Title yields empty KEY — use letters/digits"))
    (when (my/manifolding-atlas-blueprint-file-for key)
      (user-error "Blueprint exists for KEY: %s" key))
    (let* ((anchor (car (my/manifolding-atlas-blueprint-key-files)))
           (dir (if anchor (file-name-directory (cdr anchor))
                  (expand-file-name "~")))
           (path (expand-file-name (downcase key) dir)))
      (when (file-exists-p path)
        (user-error "Blueprint exists: %s" path))
      (make-directory dir t)
      (let ((id (org-id-new))
            (org-capture-templates
             `(("b" "Blueprint prompt" plain (file ,path)
                 ,(format "* %s :unfolding:file:heading:task:DRAWER_BLUEPRINT:\n:PROPERTIES:\n:ID: %s\n:END:\n** First option :BLUEPRINT_BODY:\n%%?"
                          key id)
