      (let ((alias (intern (concat "my/manifolding-atlas-prompt-"
                                   (symbol-name key-sym)))))
        (when (fboundp alias) (fmakunbound alias)))
      (message "Blueprint removed: %s" (file-name-nondirectory file)))))
