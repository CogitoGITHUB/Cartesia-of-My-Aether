(defun my/manifolding-atlas--admin-path-p (file)
  "Non-nil when FILE lives under the vault's admin/ territory.
Covers admin/unfoldings/, admin/Journal/, and admin queues alike."
  (when file
    (string-prefix-p
     (expand-file-name "admin/" (my/manifolding-atlas-root-dir))
     (file-truename file))))

(defun my/manifolding-atlas--enroll-new-note (note)
  "Enroll NOTE in mastering at birth: STAGE=AWARE, STATUS=ACTIVE.
Skips admin/ paths. Never downgrades an existing stage (transplants
may arrive with one); only fills in what is missing, ensures the
schedule row exists, and syncs the first tag. Returns NOTE."
  (when (and note
             (fboundp 'my/manifolding-atlas-mastering--init-schedule)
             (fboundp 'my/manifolding-atlas-mastering--sync-stage-tag))
    (let ((file (manifolding-atlas-note-path note)))
      (when (and file (file-exists-p file)
                 (not (my/manifolding-atlas--admin-path-p file)))
        (let ((stage nil) (status nil))
          (with-current-buffer (find-file-noselect file)
            (save-excursion
              (let ((level (manifolding-atlas-note-level note))
                    (pos (manifolding-atlas-note-pos note)))
                (if (and level (> level 0) pos)
                    (progn (goto-char pos) (org-back-to-heading t))
                  (goto-char (point-min)))
                (setq stage (my/manifolding-atlas--drawer-get "STAGE"))
                (setq status (my/manifolding-atlas--drawer-get "STATUS")))))
          ;; Birth rule: human creation is the awareness gate. Anything
          ;; already at ACQUIRING or above (transplants) is left alone.
          (let ((idx (if (and stage (fboundp 'my/manifolding-atlas-mastering--stage-index))
                         (my/manifolding-atlas-mastering--stage-index stage)
                       -1)))
            (when (< idx 1)
              (my/manifolding-atlas-mastering--put note "STAGE" "AWARE")
              (setq stage "AWARE")))
          (unless status
            (my/manifolding-atlas-mastering--put note "STATUS" "ACTIVE"))
          (my/manifolding-atlas-mastering--init-schedule nil note)
          (my/manifolding-atlas-mastering--sync-stage-tag note (or stage "AWARE"))))))
  note)
