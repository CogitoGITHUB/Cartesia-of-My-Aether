(defun my/cyberdeck-reinforce--audit-drawer-registry ()
  "Return issue strings for the :DRAWER_BLUEPRINT: registry.
Three checks, and the third is the one that matters: a property whose
file is gone, a blueprint with no property, and registry order that
disagrees with the files' current :MM_ORDER: (a sync is pending).
Passive; never writes. Plain defun with an if/else (no
`return-from', so no `cl' block needed at compile time)."
  (require 'cl-lib)
  (let ((issues nil))
    (when (fboundp 'my/cyberdeck-drawer-registry)
      (let* ((root (and (boundp 'my/cyberdeck-blueprints-root)
                        (file-name-directory my/cyberdeck-blueprints-root)))
             (entries (condition-case nil
                          (my/cyberdeck-drawer-registry)
                        (error nil)))
             (known (condition-case nil
                       (my/cyberdeck-blueprint-key-files)
                     (error nil))))
        (if (or (null root) (null known))
            (push "drawer registry: blueprint root or key files unavailable" issues)
          (dolist (e entries)
            (unless (assoc (car e) known)
              (push (format "registry: %s names no blueprint file" (car e)) issues))
            (unless (file-exists-p (expand-file-name (cdr e) root))
              (push (format "registry: %s -> %s is missing" (car e) (cdr e)) issues)))
          (dolist (pair known)
            (unless (assoc (car pair) entries)
              (push (format "registry: %s has no entry yet" (car pair)) issues)))
          ;; Drift: is the registry order what the files currently say?
          (let* ((orders nil) (i 0) (drift nil))
            (dolist (f (mapcar #'cdr known))
              (with-temp-buffer
                (insert-file-contents f)
                (goto-char (point-min))
                (when (re-search-forward "^[ \t]*:MM_ORDER:[ \t]*\\([0-9.]+\\)" nil t)
                  (push (cons (cons 0 (file-name-nondirectory f))
                              (string-to-number (match-string 1)))
                        orders))))
            (setq orders (sort orders (lambda (a b) (< (cdr a) (cdr b)))))
            (dolist (e entries)
              (let* ((want (assoc (car e) orders))
                     (have (nth i orders)))
                (when (and want have (not (equal (cdr want) (cdr have))))
                  (push (format "registry: %s is %s but should be %s (sync pending)"
                                (car e) (cdr have) (cdr want))
                        drift)))
              (setq i (1+ i)))
            (dolist (d drift) (push d issues))))))
    (nreverse issues)))

