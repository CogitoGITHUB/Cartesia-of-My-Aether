(defun my/cyberdeck-reinforce--audit ()
  "Warn about prompts not covered by any schema and templates whose
generated schema is missing or drifted. Silent when clean."
  (let* ((covered (append my/cyberdeck-reinforce-audit-allowlist
                          (my/cyberdeck-reinforce--schema-field-keys)))
         ;; Bound (not dropped) in case the query warms caches; the
         ;; uncovered-prompts warn path was never wired (see docstring
         ;; aspiration) — underscore keeps behavior identical.
         (_uncovered (my/cyberdeck-reinforce--audit-prompts covered))
         (template-issues (my/cyberdeck-reinforce--audit-templates))
         (drawer-issues (my/cyberdeck-reinforce--audit-drawer-order)))
    (when template-issues
      (lwarn 'cyberdeck-reinforce :warning
             "Template schema issues: %s"
             (string-join (nreverse template-issues) "; ")))
    (when drawer-issues
      (lwarn 'cyberdeck-reinforce :warning
             "Drawer order issues: %s"
             (string-join drawer-issues "; ")))))
