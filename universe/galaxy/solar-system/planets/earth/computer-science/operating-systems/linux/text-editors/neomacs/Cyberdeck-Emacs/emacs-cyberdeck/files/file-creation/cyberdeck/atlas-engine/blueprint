(require 'flymake)
(require 'org-element)
(require 'cyberdeck-aiu nil t)
(require 'cyberdeck-blueprint nil t)
(require 'cyberdeck-buffer nil t)
(require 'cyberdeck-db-extract nil t)

(defun cyberdeck-blueprint-flymake--aiu-region (level pos)
  "Return (BEG . END) of the header line of a note at LEVEL and POS.
For a heading-level note (LEVEL above zero) this is the heading line at
POS; for a file-level note it is the =#+title= line, or the first line
when there is none."
  (save-excursion
    (if (and level (> level 0) pos)
        (goto-char pos)
      (goto-char (point-min))
      (unless (re-search-forward "^#\\+title:" nil t)
        (goto-char (point-min))))
    (cons (line-beginning-position) (line-end-position))))

(defun cyberdeck-blueprint-flymake--field-region (field bound)
  "Return (BEG . END) of FIELD's metadata line within BOUND, or
nil. BOUND scopes the lookup to a heading subtree (see
`cyberdeck-buffer-meta')
and is nil for file-level metadata."
  (when-let* ((meta (cyberdeck-buffer-meta--get (cyberdeck-buffer-meta bound) field))
              (item (car (plist-get meta :items)))
              (beg (org-element-aiu-context :begin item)))
    (cons beg (save-excursion (goto-char beg) (line-end-position)))))

(defun cyberdeck-blueprint-flymake--violation-region (violation data level)
  "Return (BEG . END) in the current buffer for VIOLATION.
DATA is the extraction plist of the offending note and LEVEL its level.
A value violation points at its field's line; a missing required field
\(which has no line) points at the AIU's header line."
  (let ((field (cyberdeck-violation-field violation))
        (bound (when (and level (> level 0)) (plist-get data :pos))))
    (or (and field
             (not (eq (cyberdeck-violation-type violation) 'missing-required))
             (cyberdeck-blueprint-flymake--field-region field bound))
        (cyberdeck-blueprint-flymake--aiu-region level (plist-get data :pos)))))

(defun cyberdeck-blueprint-flymake--collect ()
  "Return schema-violation diagnostics for the notes in the current buffer.
Each element is (BEG END TYPE TEXT), ready for `flymake-make-diagnostic'."
  (let* ((ast (org-element-parse-buffer))
         (path (or (buffer-file-name) (buffer-name)))
         (file-title (cyberdeck-db--extract-file-title ast path))
         (datas (cons (cyberdeck-db--extract-file-node ast path (current-buffer) file-title)
                      (cyberdeck-db--extract-heading-nodes ast path (current-buffer) file-title)))
         (diagnostics nil))
    (dolist (data datas)
      (when (plist-get data :id)
