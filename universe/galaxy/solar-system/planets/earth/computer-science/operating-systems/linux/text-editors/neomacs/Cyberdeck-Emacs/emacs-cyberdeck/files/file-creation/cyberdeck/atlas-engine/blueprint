(defun my/cyberdeck-blueprint-migrate-warnings ()
  "Delete all unfoldings with value \"WARNING\" throughout the vault.

Under the old prompt system, skipping a prompt stored \"WARNING\" as
the unfolding value to track it in Static Blueprints.  Now schema
validation flags notes that are *missing* the metadata entirely as
`missing-required` violations, so the sentinel is no longer needed.
Deleting the WARNING sentinel lets the description-list metadata
(eg - STATE_WORK :: ACTIVE) become the canonical value."
  (interactive)
  (unless (yes-or-no-p
           "Delete all \"WARNING\" AIU Context values throughout the vault? ")
    (user-error "Aborted"))
  (let ((count 0)
        (files (make-hash-table :test #'equal)))
    ;; Group AIUs by file so we only visit each file once
    (dolist (note (cyberdeck-db-query))
      (let ((file (cyberdeck-aiu-path note)))
        (when (and file (file-exists-p file))
          (push (list :level (cyberdeck-aiu-level note)
                      :pos (cyberdeck-aiu-pos note))
                (gethash file files)))))
    (maphash
     (lambda (file notes)
       (setq count
             (+ count (my/cyberdeck-blueprint--migrate-file-warnings
                       file notes))))
     files)
     (message "Migration complete: deleted %d WARNING AIU Context values (existing metadata preserved)." count)))
