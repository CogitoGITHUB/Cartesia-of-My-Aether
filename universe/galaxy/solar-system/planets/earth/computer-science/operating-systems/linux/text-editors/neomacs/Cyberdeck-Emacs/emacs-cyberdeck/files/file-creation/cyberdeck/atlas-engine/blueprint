#+begin_src emacs-lisp
(require 'cyberdeck-aiu nil t)
(require 'cyberdeck-blueprint nil t)
(require 'cyberdeck-db-extract nil t)

(defcustom cyberdeck-db-blueprint-validation-action 'warning
  "How to react when an indexed note violates an applicable schema.

The check runs while a note is written to the database (on save,
external sync, or a full scan), and only when schemas are registered and
one applies to the note - otherwise it does nothing.

- `silent'  index the note, say nothing.
- `warning' index the note, emit a non-blocking warning naming the
            violations (the default).
- `error'   keep the violating note OUT of the database (skip indexing
            it) and emit a warning.  The file on disk is untouched, so
            the note simply stays absent from the database until it is
            fixed and re-synced.

Because files are the source of truth, none of these touch the file;
they only control whether the database mirrors a violating AIU."
  :type '(choice (const :tag "Index silently" silent)
                 (const :tag "Index and warn" warning)
                 (const :tag "Skip and warn" error))
  :group 'cyberdeck)

(defun cyberdeck-db-blueprint-validation--format (note violations)
  "Format VIOLATIONS of NOTE into a human-readable warning string."
  (format "AIU %S (%s) violates its schema:\n%s"
          (cyberdeck-aiu-title note)
          (cyberdeck-aiu-id note)
          (mapconcat
           (lambda (v)
             (format "  - [%s] %s"
                     (cyberdeck-violation-schema v)
                     (cyberdeck-violation-message v)))
           violations "\n")))

(defun cyberdeck-db-blueprint-validation--warn (note violations level)
  "Emit a warning at LEVEL describing VIOLATIONS of NOTE."
  (lwarn 'cyberdeck-blueprint level "%s"
         (cyberdeck-db-blueprint-validation--format note violations)))

(defun cyberdeck-db-blueprint-validation--filter (note)
  "Validate NOTE for `cyberdeck-db-aiu-index-filter-functions'.

Return non-nil to allow indexing NOTE and nil to skip it,
dispatching on `cyberdeck-db-blueprint-validation-action'.
Fast-exits when validation is
`silent' or no schemas are registered, and never affects a note that
conforms or that no schema applies to."
  (if (or (eq cyberdeck-db-blueprint-validation-action 'silent)
          (null (cyberdeck-blueprint-list)))
      t
    (let ((violations (cyberdeck-blueprint-aiu-violations note)))
      (cond
       ((null violations) t)
       ((eq cyberdeck-db-blueprint-validation-action 'error)
        (cyberdeck-db-blueprint-validation--warn note violations :error)
        nil)
       (t
        (cyberdeck-db-blueprint-validation--warn note violations :warning)
        t)))))

(add-hook 'cyberdeck-db-aiu-index-filter-functions
          #'cyberdeck-db-blueprint-validation--filter)

(provide 'cyberdeck-db-blueprint-validation)
