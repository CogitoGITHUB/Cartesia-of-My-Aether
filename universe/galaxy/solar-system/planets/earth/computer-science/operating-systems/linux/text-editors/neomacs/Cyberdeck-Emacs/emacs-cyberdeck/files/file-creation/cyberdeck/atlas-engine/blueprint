;;; Schema structure

(cl-defstruct (cyberdeck-blueprint (:constructor cyberdeck-blueprint--create)
                             (:copier nil))
  "A schema describing structured expectations for a class of notes.

Slots:
  name      - symbol identifying the schema
  predicate - function (note) -> non-nil selecting notes it applies to
  fields    - list of OWN field spec plists (see Commentary).  Use
              `cyberdeck-blueprint-effective-fields' for the
              merged list (own fields over includes').
  includes  - names of the schemas this one inherits fields from"
  name
  predicate
  fields
  includes)

;;; Registry

(defvar cyberdeck-blueprint--registry (make-hash-table :test 'eq)
  "Registry of defined schemas, keyed by name symbol.")

(defvar cyberdeck-blueprint--generation 0
  "Bumped on every define/unregister; invalidates the effective-fields cache.")

(defvar cyberdeck-blueprint--effective-cache (make-hash-table :test 'eq)
  "Schema name -> (GENERATION . MERGED-FIELDS).")

(defvar cyberdeck-blueprint--resolving nil
  "Names currently being merged (cycle guard for lazy :include).")

(defun cyberdeck-blueprint--merge-fields (field-lists)
  "Merge FIELD-LISTS, a list of field-spec lists, into a single list.
The lists are processed in order; a later field spec overrides an
earlier one with the same :key, whether the duplicate falls within a
single list or across lists, while an overridden field keeps the
position of its first appearance.  Used to fold the fields of included
schemas into a schema that names them in :include."
  (let ((order nil)
        (by-key (make-hash-table :test 'equal)))
    (dolist (fields field-lists)
      (dolist (field fields)
        (let ((key (plist-get field :key)))
          (unless (gethash key by-key)
            (push key order))
          (puthash key field by-key))))
    (mapcar (lambda (key) (gethash key by-key)) (nreverse order))))

(cl-defun cyberdeck-blueprint-define (name &key predicate fields include)
  "Define and register a schema called NAME.

PREDICATE is a function (note) -> non-nil when the schema applies to
the note.  FIELDS is a list of field spec plists (see Commentary for
the supported keys).

INCLUDE names another schema to inherit fields from - a schema
name symbol, a `cyberdeck-blueprint' object, or a list of
either. The included schemas contribute their fields first
(multiple includes merged
left-to-right), then FIELDS.  When a :key appears more than once the
later definition wins, so FIELDS overrides an included field and a
later include overrides an earlier one; an overridden field keeps the
position of its first appearance.  Includes resolve lazily at first
use (see `cyberdeck-blueprint-effective-fields'), so definition
order never matters and re-defining an included schema updates all its
includers.  Cyclic :include chains signal an error when merged.

Registering a schema with an existing NAME replaces it.  Returns the
`cyberdeck-blueprint' object."
  (unless (symbolp name)
    (error "Schema name must be a symbol: %S" name))
  (unless (functionp predicate)
    (error "Schema :predicate must be a function"))
  (dolist (field fields)
    (unless (and (plist-member field :key)
                 (stringp (plist-get field :key)))
      (error "Schema field must have a string :key: %S" field)))
  (let ((includes (cond
                   ((null include) nil)
                   ((or (symbolp include) (cyberdeck-blueprint-p include)) (list include))
                   ((listp include) include)
                   (t (error "Schema :include must be a symbol, a schema, or a list of them: %S"
                             include)))))
    (let ((schema (cyberdeck-blueprint--create
                   :name name
                   :predicate predicate
                   :includes (mapcar (lambda (s)
                                       (if (cyberdeck-blueprint-p s)
                                           (cyberdeck-blueprint-name s)
                                         s))
                                     includes)
                   :fields fields)))
      (puthash name schema cyberdeck-blueprint--registry)
      (setq cyberdeck-blueprint--generation
            (1+ cyberdeck-blueprint--generation))
      schema)))

(defun cyberdeck-blueprint--compute-fields (schema)
  "Merge SCHEMA's own fields over its includes', recursively."
  (let ((name (cyberdeck-blueprint-name schema)))
    (when (memq name cyberdeck-blueprint--resolving)
      (error "Cyclic schema :include involving %S" name))
    (let ((cyberdeck-blueprint--resolving
           (cons name cyberdeck-blueprint--resolving)))
      (cyberdeck-blueprint--merge-fields
       (append (mapcar (lambda (s)
                         (cyberdeck-blueprint-effective-fields
                          (cyberdeck-blueprint--resolve s)))
                       (cyberdeck-blueprint-includes schema))
               (list (cyberdeck-blueprint-fields schema)))))))

(defun cyberdeck-blueprint-effective-fields (schema-or-name)
  "Merged field list for SCHEMA-OR-NAME: includes first, own fields last.
Resolved lazily with per-generation memoization, so schema definition
order never matters.  Signals an error on cyclic :include chains or
genuinely missing schemas (same message as direct resolution)."
  (let ((schema (cyberdeck-blueprint--resolve schema-or-name)))
    (let ((hit (gethash (cyberdeck-blueprint-name schema)
                        cyberdeck-blueprint--effective-cache)))
      (if (and hit (eq (car hit) cyberdeck-blueprint--generation))
          (cdr hit)
        (let ((merged (cyberdeck-blueprint--compute-fields schema)))
          (puthash (cyberdeck-blueprint-name schema)
                   (cons cyberdeck-blueprint--generation merged)
                   cyberdeck-blueprint--effective-cache)
          merged)))))

(defun cyberdeck-blueprint-get (name)
  "Return the registered schema called NAME, or nil."
  (gethash name cyberdeck-blueprint--registry))

(defun cyberdeck-blueprint-list ()
  "Return the list of registered schema names."
  (let (names)
    (maphash (lambda (k _v) (push k names)) cyberdeck-blueprint--registry)
    (nreverse names)))

(defun cyberdeck-blueprint-unregister (name)
  "Remove the schema called NAME from the registry."
  (remhash name cyberdeck-blueprint--registry)
  (setq cyberdeck-blueprint--generation
        (1+ cyberdeck-blueprint--generation)))

(defun cyberdeck-blueprint--resolve (schema-or-name)
  "Return a `cyberdeck-blueprint' from SCHEMA-OR-NAME.

SCHEMA-OR-NAME is either a `cyberdeck-blueprint' object
or the symbol name of a registered schema. Signals an error when
a name is not registered."
  (cond
   ((cyberdeck-blueprint-p schema-or-name) schema-or-name)
   ((symbolp schema-or-name)
    (or (cyberdeck-blueprint-get schema-or-name)
        (error "No schema registered as %S" schema-or-name)))
   (t (error "Not a schema or schema name: %S" schema-or-name))))

;;; Field access

(defun cyberdeck-blueprint-field-value (note field)
  "Return the value of FIELD for NOTE, read with the field's declared type.

FIELD is a field spec plist or a bare metadata key string (in which
case the type defaults to `string'). Reads from the note's
already-extracted metadata via `cyberdeck-aiu-meta-get'.
When the field spec is :multiple, returns a list of values."
  (let* ((spec (if (stringp field) (list :key field) field))
         (key (plist-get spec :key))
         (type (or (plist-get spec :type) 'string)))
    (if (plist-get spec :multiple)
        (cyberdeck-aiu-meta-get-list note key type)
      (cyberdeck-aiu-meta-get note key type))))

;;; Predicate

(defun cyberdeck-blueprint-applies-p (note schema-or-name)
  "Return non-nil when SCHEMA-OR-NAME's predicate matches NOTE.

SCHEMA-OR-NAME is a `cyberdeck-blueprint' object or a
registered schema name."
  (let ((schema (cyberdeck-blueprint--resolve schema-or-name)))
    (funcall (cyberdeck-blueprint-predicate schema) note)))

;;; Validation

(cl-defstruct (cyberdeck-violation (:copier nil))
  "A single schema violation found on a note.

Slots:
  aiu-id    - id of the offending note
  aiu-title - title of the offending note
  schema     - name of the schema that was violated
  field      - metadata key of the offending field
  type       - violation type symbol (see `cyberdeck-blueprint-validate')
  message    - human-readable description
  value      - the offending value, when applicable"
  aiu-id aiu-title schema field type message value)

(defun cyberdeck-blueprint--call-or-value (spec note)
  "Resolve SPEC for NOTE: call it when a function, otherwise return it.
Used for field keys like :required and :one-of that accept either a
literal or a function of the AIU."
  (if (functionp spec) (funcall spec note) spec))

(defun cyberdeck-blueprint--coerce (raw type)
  "Coerce the RAW string value to TYPE for comparison."
  (pcase type
    ('number (string-to-number raw))
    ('symbol (intern raw))
    (_ raw)))

(defun cyberdeck-blueprint--link-id (raw)
  "Return the note id referenced by RAW, or nil when RAW is not an id link.
Accepts a bracket link \"[[id:UUID][desc]]\" or a bare UUID."
  (cond
   ((string-match org-link-bracket-re raw)
    (let ((link (match-string 1 raw)))
      (when (string-prefix-p "id:" link)
        (string-remove-prefix "id:" link))))
   ((string-match-p (concat "\\`" (or (bound-and-true-p cyberdeck-utils--uuid-regexp) "[0-9a-fA-F\\-]\\{36\\}") "\\'") raw)
     raw)))

(defun cyberdeck-blueprint--violation (note schema field type message value)
  "Build a `cyberdeck-violation' for NOTE on SCHEMA's FIELD of TYPE.
MESSAGE describes the problem and VALUE is the offending value."
  (make-cyberdeck-violation
   :aiu-id (cyberdeck-aiu-id note)
   :aiu-title (cyberdeck-aiu-title note)
   :schema (cyberdeck-blueprint-name schema)
   :field (plist-get field :key)
   :type type
   :message message
   :value value))

(defun cyberdeck-blueprint--target-tags-violation (target id field note schema)
  "Return a violation when TARGET is missing FIELD's :target-tags, else nil.

TARGET is the resolved `cyberdeck-aiu' referenced by FIELD
on NOTE, and ID is its id (used in the message and as the
offending value). SCHEMA owns
the field.  All declared tags must be present (all-of); the missing ones
are named in the message."
  (let* ((required (plist-get field :target-tags))
         (missing (and required
                       (cl-remove-if
                        (lambda (tag) (member tag (cyberdeck-aiu-tags target)))
                        required))))
    (when missing
      (cyberdeck-blueprint--violation
       note schema field 'invalid-target
       (format "Field %S target %s is missing required tag(s) %S"
               (plist-get field :key) id missing)
       id))))

(defun cyberdeck-blueprint--value-violation (raw field note schema)
  "Return a violation for the RAW value of FIELD on NOTE, or nil when valid.
SCHEMA is the owning schema.  Checks, in order: type, reference
resolution and :target-tags (for `note' fields), allowed values, then a
custom :validate function.  Returns the first problem found."
  (let* ((key (plist-get field :key))
         (type (or (plist-get field :type) 'string))
         (one-of (cyberdeck-blueprint--call-or-value (plist-get field :one-of) note))
         (validate (plist-get field :validate)))
    (or
     ;; type / reference checks
     (pcase type
       ('number
        (unless (string-match-p "\\`[ \t]*-?[0-9][0-9.]*[ \t]*\\'" raw)
          (cyberdeck-blueprint--violation
           note schema field 'wrong-type
           (format "Field %S expected a number, got %S" key raw) raw)))
       ((or 'note 'link)
        (let ((id (cyberdeck-blueprint--link-id raw)))
          (cond
           ((null id)
            (cyberdeck-blueprint--violation
             note schema field 'wrong-type
             (format "Field %S expected an id link, got %S" key raw) raw))
           ;; `link' fields only check the id-link shape; `AIU' fields
           ;; additionally resolve the target and enforce :target-tags.
           ((eq type 'note)
            (let ((target (cyberdeck-db-get-by-id id)))
              (if (not target)
                  (cyberdeck-blueprint--violation
                   note schema field 'invalid-reference
                   (format "Field %S references missing AIU %s" key id) id)
                (cyberdeck-blueprint--target-tags-violation
                 target id field note schema))))))))
     ;; allowed values (not meaningful for note/link references)
     (when (and one-of (not (memq type '(note link))))
       (let ((typed (cyberdeck-blueprint--coerce raw type)))
         (unless (member typed one-of)
           (cyberdeck-blueprint--violation
            note schema field 'disallowed-value
            (format "Field %S value %S is not one of %S" key typed one-of)
            typed))))
     ;; custom validator
     (when validate
       (let* ((typed (cyberdeck-blueprint--coerce raw type))
              (result (funcall validate typed note)))
         (unless (eq result t)
           (cyberdeck-blueprint--violation
            note schema field 'invalid-value
            (if (stringp result) result
              (format "Field %S failed validation" key))
            typed)))))))

(defun cyberdeck-blueprint--field-violations (note field schema)
  "Return the list of violations for FIELD on AIU against SCHEMA."
  (let* ((key (plist-get field :key))
         (required (cyberdeck-blueprint--call-or-value (plist-get field :required) note))
         (raws (cyberdeck-aiu-meta-get-list note key 'string)))
    (cond
     ((and required (null raws))
      (list (cyberdeck-blueprint--violation
             note schema field 'missing-required
             (format "Required field %S is missing" key) nil)))
     ((null raws) nil)
     (t (delq nil
              (mapcar (lambda (raw)
                        (cyberdeck-blueprint--value-violation raw field note schema))
                      raws))))))

(defun cyberdeck-blueprint-validate (note schema-or-name)
  "Return the list of `cyberdeck-violation' for NOTE
against SCHEMA-OR-NAME.

SCHEMA-OR-NAME is a `cyberdeck-blueprint' object or a
registered schema name. Each field is checked for the following
problem types:

- `missing-required'   a required field has no value
- `wrong-type'         a value does not match the field's declared type
- `invalid-reference'  a `note' field links to a non-existent note
- `invalid-target'     a `note' field's target is missing a :target-tags tag
- `disallowed-value'   a value is not in the field's :one-of set
- `invalid-value'      a value is rejected by the field's :validate function

The note is validated as given; the schema's predicate is not consulted
here (see `cyberdeck-blueprint-validate-all')."
  (let ((schema (cyberdeck-blueprint--resolve schema-or-name)))
    (cl-loop for field in (cyberdeck-blueprint-effective-fields schema)
             append (cyberdeck-blueprint--field-violations note field schema))))

(defun cyberdeck-blueprint-validate-aius (notes schema-or-name)
  "Return all violations for NOTES against SCHEMA-OR-NAME.

NOTES is any list of `cyberdeck-aiu' objects; every note is validated
regardless of the schema's predicate. To validate only the notes
a schema applies to, filter with
`cyberdeck-blueprint-applies-p' first, or use
`cyberdeck-blueprint-validate-all'."
  (let ((schema (cyberdeck-blueprint--resolve schema-or-name)))
    (cl-loop for note in notes
             append (cyberdeck-blueprint-validate note schema))))

(defun cyberdeck-blueprint-validate-all (schema-or-name)
  "Return all violations for every note matched by SCHEMA-OR-NAME.

Notes are selected with the schema's predicate, then validated.
This is sugar for `cyberdeck-blueprint-validate-aius'
over the matching AIUs."
  (let ((schema (cyberdeck-blueprint--resolve schema-or-name)))
    (cyberdeck-blueprint-validate-aius
     (cyberdeck-db-query (lambda (note) (cyberdeck-blueprint-applies-p note schema)))
     schema)))

;;; Authoring

(defun cyberdeck-blueprint-applicable (note)
  "Return the names of registered schemas whose predicate matches NOTE.
Schemas are tested in registration order."
  (cl-remove-if-not (lambda (name) (cyberdeck-blueprint-applies-p note name))
                    (cyberdeck-blueprint-list)))

(defun cyberdeck-blueprint-missing-fields (note schema-or-name &optional required-only)
  "Return the fields of SCHEMA-OR-NAME that NOTE has no value for.

Required fields come first (in declared order), then optional ones;
with REQUIRED-ONLY non-nil only required fields are returned.
Requiredness is evaluated against NOTE, so a function :required is
honored.  A field counts as present when NOTE has any value for its
:key, so this never proposes a field the AIU already carries."
  (let ((schema (cyberdeck-blueprint--resolve schema-or-name))
        (required nil)
        (optional nil))
    (dolist (field (cyberdeck-blueprint-effective-fields schema))
      (when (null (cyberdeck-aiu-meta-get-list note (plist-get field :key) 'string))
        (if (cyberdeck-blueprint--call-or-value (plist-get field :required) note)
            (push field required)
          (unless required-only (push field optional)))))
    (append (nreverse required) (nreverse optional))))

(defun cyberdeck-blueprint-aiu-violations (note)
  "Return all violations of NOTE across the schemas that apply to it.

Validates NOTE against each schema named by
`cyberdeck-blueprint-applicable' and concatenates the
results. Returns nil when no schema applies or the
note conforms to all that do.  This is the per-aiu counterpart to
`cyberdeck-blueprint-validate-all' and the shared entry
point for surfacing a single note's violations (sync warnings,
in-buffer linting, health
widgets)."
  (cl-loop for name in (cyberdeck-blueprint-applicable note)
           append (cyberdeck-blueprint-validate note name)))

;;; Collection health

(cl-defstruct (cyberdeck-blueprint-health (:constructor cyberdeck-blueprint-health--create)
                                    (:copier nil))
  "Aggregated health of a single schema across a set of notes.

Slots:
  schema        - schema name symbol
  covered       - number of notes the schema applies to
  invalid       - number of covered notes with at least one violation
  invalid-aius - list of (note . violations) for the invalid notes
  includes      - schema names this schema inherits fields from
  included-by   - schema names that inherit fields from this schema"
  schema covered invalid invalid-aius includes included-by)

(cl-defun cyberdeck-blueprint-collection-health (&optional (notes (cyberdeck-db-query)))
  "Return the health of every registered schema across NOTES.

NOTES defaults to all notes in the database.  The result is a list of
`cyberdeck-blueprint-health' structures, one per registered schema in
registration order, each carrying how many notes the schema covers, how
many of those are invalid, the invalid notes paired with their
violations, and the schema's include relationships.  Pure apart from the
default `cyberdeck-db-query'; pass NOTES to aggregate an explicit set."
  (let ((by-name (make-hash-table :test 'eq))
        (included-by (make-hash-table :test 'eq))
        result)
    (dolist (name (cyberdeck-blueprint-list))
      (let ((includes (cyberdeck-blueprint-includes (cyberdeck-blueprint-get name))))
        (puthash name (cyberdeck-blueprint-health--create
                       :schema name :covered 0 :invalid 0
                       :invalid-aius nil :includes includes)
                 by-name)
        (dolist (inc includes)
          (push name (gethash inc included-by)))))
    (dolist (note notes)
      (dolist (name (cyberdeck-blueprint-applicable note))
        (let ((h (gethash name by-name)))
          (when h
            (cl-incf (cyberdeck-blueprint-health-covered h))
            (let ((vs (cyberdeck-blueprint-validate note name)))
              (when vs
                (cl-incf (cyberdeck-blueprint-health-invalid h))
                (push (cons note vs) (cyberdeck-blueprint-health-invalid-aius h))))))))
    (dolist (name (cyberdeck-blueprint-list))
      (let ((h (gethash name by-name)))
        (setf (cyberdeck-blueprint-health-invalid-aius h)
              (nreverse (cyberdeck-blueprint-health-invalid-aius h)))
        (setf (cyberdeck-blueprint-health-included-by h)
              (nreverse (gethash name included-by)))
        (push h result)))
    (nreverse result)))

(provide 'cyberdeck-blueprint)
