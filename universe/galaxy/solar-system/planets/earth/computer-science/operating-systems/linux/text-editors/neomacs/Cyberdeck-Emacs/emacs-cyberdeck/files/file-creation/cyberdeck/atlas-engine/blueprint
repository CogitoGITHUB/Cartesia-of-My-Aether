(defun my/cyberdeck-reinforce-sweep ()
  "Run a full-vault schema sweep and rebuild Static Blueprints."
  (interactive)
  ;; Sweeps can fire at arbitrary ambient stack depth (idle inside
  ;; recursive-edits etc). Carry an independent deep budget so ambient
  ;; depth is irrelevant. max-specpdl-size is obsolete as of 29.1 but
  ;; still honored; the binding stays, warning suppressed.
  (with-no-warnings
    (let ((max-lisp-eval-depth 12000)
          (max-specpdl-size 12000))
      (condition-case err
        (progn
          (my/cyberdeck-missing--rebuild-from-health)
          (setq my/cyberdeck-reinforce--last-sweep (float-time))
          ;; Keep the blueprint registry complete. `refresh' only ever
          ;; appends a missing entry, so running it from the idle sweep
          ;; cannot disturb an arrangement. The destructive half — sync,
          ;; which rewrites every :MM_ORDER: — stays interactive.
          (ignore-errors
            (when (fboundp 'my/cyberdeck-drawer-registry-refresh)
              (my/cyberdeck-drawer-registry-refresh)))
          (my/cyberdeck-reinforce--audit))
      (error (message "Schema sweep failed: %s" err))))))
