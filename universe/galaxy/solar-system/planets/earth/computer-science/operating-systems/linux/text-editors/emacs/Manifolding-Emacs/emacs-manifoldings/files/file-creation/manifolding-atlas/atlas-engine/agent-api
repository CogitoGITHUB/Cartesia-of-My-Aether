#+title:      Agent API

* Agent API :EMACS_MECHANISM:
:PROPERTIES:
:ID:       6b2d7bc9-7c42-4dd0-80b3-dd1bfc16cda5
:END:

Plain-data bridge for AI agents: read the atlas (query, node,
schema), write through the same primitives interactive use
(set-field, link), with a provenance sidecar on every agent write.
Catalog documents the surface.  An explicit endpoint opts the
session into connected AI features; without one a single boot
warning says so and the dormant features stay off.  Nothing here
runs at load except the one-shot boot check.

** Endpoint + status
#+begin_src emacs-lisp
(require 'cl-lib)
(require 'json)

(defcustom my/atlas-agent-endpoint nil
  "Agent endpoint URL, or nil when no agent is connected.
Semantic similarity and AI proposals stay dormant without one."
  :type '(choice (const nil) string) :group 'manifolding-atlas)

(defun my/atlas-agent-status ()
  "Report agent connection state."
  (interactive)
  (if my/atlas-agent-endpoint
      (message "agent connected: %s" my/atlas-agent-endpoint)
    (message "no agent connected: AI features dormant")))

(defun my/atlas-agent-boot-check ()
  "One-shot boot warning when no agent is connected."
  (unless (or noninteractive my/atlas-agent-endpoint)
    (display-warning 'manifolding-atlas
                     "No agent connected (my/atlas-agent-endpoint is nil): semantic similarity and AI proposals are dormant."
                     :warning)))

(add-hook 'after-init-hook #'my/atlas-agent-boot-check)
#+end_src

** Reads
#+begin_src emacs-lisp
(defun my/atlas-api-query (&optional filter)
  "Notes as plists, optionally filtered by FILTER plist (:tag T ...)."
  (let ((notes (ignore-errors (manifolding-atlas-db-query))))
    (if (null filter)
        notes
      (let ((tag (plist-get filter :tag)))
        (if tag
            (seq-filter (lambda (n)
                          (member tag (ignore-errors
                                       (manifolding-atlas-note-tags n))))
                        notes)
          notes)))))

(defun my/atlas-api-node (id)
  "Note plist for ID, or nil."
  (and (fboundp 'manifolding-atlas-db-get-by-id)
       (ignore-errors (manifolding-atlas-db-get-by-id id))))

(defun my/atlas-api-schema (name)
  "Schema NAME as plist (:name :fields (:key...) :includes), or nil."
  (when (and (fboundp 'manifolding-atlas-blueprint-get)
             (fboundp 'manifolding-atlas-blueprint-effective-fields))
    (let ((s (manifolding-atlas-blueprint-get name)))
      (when s
        (list :name name
              :fields (mapcar (lambda (f) (plist-get f :key))
                              (ignore-errors
                               (manifolding-atlas-blueprint-effective-fields s)))
              :includes (and (fboundp 'manifolding-atlas-blueprint-includes)
                             (manifolding-atlas-blueprint-includes s)))))))

(defun my/atlas-api-catalog ()
  "The API surface: ((KIND NAME PARAMS)...)."
  (list (list :read 'my/atlas-api-query '(&optional filter))
        (list :read 'my/atlas-api-node '(id))
        (list :read 'my/atlas-api-schema '(name))
        (list :write 'my/atlas-api-set-field '(id key value &optional agent))
        (list :write 'my/atlas-api-link '(from-id to-id &optional type))))

(defun my/atlas-api-json (object)
  "Encode OBJECT (plists/lists/strings) as JSON."
  (json-encode object))
#+end_src

** Writes with provenance
#+begin_src emacs-lisp
(defmacro my/atlas-api--with-note (id &rest body)
  "Run BODY in the buffer at note ID's heading."
  (declare (indent 1) (debug t))
  `(let* ((me-note (my/atlas-api-node ,id))
          (me-id (ignore-errors (manifolding-atlas-note-id me-note)))
          (me-marker (and me-id (ignore-errors (org-id-find me-id t)))))
     (unless (and me-marker (marker-buffer me-marker))
       (error "agent api: note %s not found" ,id))
     (with-current-buffer (marker-buffer me-marker)
       (save-excursion
         (goto-char me-marker)
         (org-back-to-heading t)
         ,@body))))

(defun my/atlas-api-set-field (id key value &optional agent)
  "Set drawer KEY to VALUE on note ID.  AGENT plist (:model M) records
provenance in a :PROVENANCE_<KEY>: entry."
  (my/atlas-api--with-note id
    (when (fboundp 'my/manifolding-atlas--drawer-put)
      (my/manifolding-atlas--drawer-put key value))
    (when agent
      (let ((model (or (plist-get agent :model) "agent"))
            (now (format-time-string "%Y-%m-%dT%H:%M:%S")))
        (when (fboundp 'my/manifolding-atlas--drawer-put)
          (my/manifolding-atlas--drawer-put
           (concat "PROVENANCE_" key)
           (format "%s|%s" model now)))))
    (save-buffer))
  value)

(defun my/atlas-api-link (from-id to-id &optional type)
  "Record a link FROM-ID -> TO-ID (TYPE informational, default reference).
Appends an id: link line under the source heading."
  (ignore type)
  (let ((target (my/atlas-api-node to-id)))
    (unless target (error "agent api: target %s not found" to-id))
    (my/atlas-api--with-note from-id
      (goto-char (org-entry-end-position))
      (insert (format "\n%s\n"
                      (manifolding-atlas-utils-link-make-string target))))
    (save-buffer)
    t))
#+end_src
