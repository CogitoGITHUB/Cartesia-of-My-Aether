(defun my/atlas-sidebar--note-at-point ()
  "Atlas note at point or in this buffer, or nil."
  (or (and (fboundp 'my/manifolding-atlas--note-at-point)
           (ignore-errors (my/manifolding-atlas--note-at-point)))
      (and (fboundp 'my/manifolding-atlas--buffer-note)
           (ignore-errors (my/manifolding-atlas--buffer-note)))))

(defun my/atlas-sidebar-refresh ()
  "Fill *Atlas Sidebar* with context and backlinks.  Read-only."
  (interactive)
  (let ((buf (get-buffer "*Atlas Sidebar*")))
    (when (buffer-live-p buf)
      (with-current-buffer buf
        (let ((inhibit-read-only t)
              (note (my/atlas-sidebar--note-at-point)))
          (erase-buffer)
          (insert "* Atlas Sidebar\n\n")
          (if (null note)
              (insert "- No Atlas note at point (open a vault file)\n")
            (when (fboundp 'my/atlas-node-view-sections)
              (insert "-- Context --\n")
              (dolist (sec (ignore-errors (my/atlas-node-view-sections note)))
                (insert (format "%s: %s\n" (car sec) (cdr sec))))
              (insert "\n"))
            (when (fboundp 'my/atlas-node-view-backlinks)
              (insert "-- Backlinks --\n")
              (let ((bl (ignore-errors (my/atlas-node-view-backlinks note))))
                (if bl
                    (dolist (b bl) (insert b "\n"))
                  (insert "none\n")))))
          (my/atlas-sidebar-insert-outline note)
          (my/atlas-sidebar-insert-digest note)
          (insert "\n[q] close  [g] refresh\n"))))))
