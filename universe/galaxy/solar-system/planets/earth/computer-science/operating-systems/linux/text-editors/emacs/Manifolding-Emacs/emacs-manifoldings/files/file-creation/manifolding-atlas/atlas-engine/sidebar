** Buffer outline
Native clickable heading tree of the followed buffer: indent,
jump buttons, current-heading mark, depth cycling.  Built on
plain regex (imenu/org-element need no display), capped for
huge buffers.  Nothing here runs at load.
#+begin_src emacs-lisp
(defvar my/atlas-sidebar-outline-limit 500
  "Max headings rendered in the outline section.")

(defvar my/atlas-sidebar-outline-depth nil
  "Max level shown; nil shows all.  Cycled by command.")

(defun my/atlas-sidebar-outline-entries ()
  "List of (LEVEL TITLE POS) for the followed buffer, capped."
  (let (out (n 0))
    (when (buffer-live-p my/atlas-sidebar-source-buffer)
      (with-current-buffer my/atlas-sidebar-source-buffer
        (when (derived-mode-p 'org-mode)
          (save-excursion
            (goto-char (point-min))
            (while (and (< n my/atlas-sidebar-outline-limit)
                        (re-search-forward "^\\(\\*+\\) \\(.*\\)$" nil t))
              (push (list (length (match-string-no-properties 1))
                          (match-string-no-properties 2)
                          (match-beginning 0))
                    out)
              (setq n (1+ n)))))))
    (nreverse out)))

(defun my/atlas-sidebar-outline-current (entries)
  "Buffer position of the entry at or before point, or nil."
  (let ((pt (when (buffer-live-p my/atlas-sidebar-source-buffer)
              (with-current-buffer my/atlas-sidebar-source-buffer
                (point))))
        (best nil))
    (dolist (e entries)
      (when (and pt (>= pt (nth 2 e)))
        (setq best (nth 2 e))))
    best))

(defun my/atlas-sidebar-goto-entry (entry)
  "Jump to outline ENTRY in the followed buffer."
  (let ((buf my/atlas-sidebar-source-buffer))
    (when (buffer-live-p buf)
      (pop-to-buffer buf)
      (goto-char (nth 2 entry)))))

(defun my/atlas-sidebar-cycle-depth ()
  "Cycle outline depth 1-2-3-all."
  (interactive)
  (setq my/atlas-sidebar-outline-depth
        (pcase my/atlas-sidebar-outline-depth
          ('nil 1) (1 2) (2 3) (_ nil)))
  (my/atlas-sidebar-refresh))

(defun my/atlas-sidebar-insert-outline (_note)
  "Render the outline section for the followed buffer, if any."
  (let ((entries (my/atlas-sidebar-outline-entries)))
    (when entries
      (insert "-- Outline --\n")
      (let ((cur (my/atlas-sidebar-outline-current entries)))
        (dolist (e entries)
          (let ((entry e))
            (when (or (null my/atlas-sidebar-outline-depth)
                      (<= (nth 0 entry) my/atlas-sidebar-outline-depth))
              (insert (if (equal (nth 2 entry) cur) ">> " "   "))
              (insert-text-button
               (format "%s%s" (make-string (* 2 (1- (nth 0 entry))) ?\s)
                       (nth 1 entry))
               'action (lambda (_) (my/atlas-sidebar-goto-entry entry)))
              (insert "\n"))))))))
#+end_src

** Due digest
Condensed rollup calling the agenda-day machinery (never duplicated):
counts plus the next few items.  Full detail lives in `agenda-day`.
#+begin_src emacs-lisp
(defun my/atlas-sidebar-insert-digest (_note)
  "Render the due digest section, when agenda-day is loaded."
  (when (and (fboundp 'my/manifolding-atlas-agenda--due-entries)
             (fboundp 'my/manifolding-atlas-agenda--due-protocols))
    (let ((entries (ignore-errors (my/manifolding-atlas-agenda--due-entries)))
          (protos (ignore-errors (my/manifolding-atlas-agenda--due-protocols))))
      (insert "-- Due --\n")
      (insert (format "routines due: %d \u00b7 protocols due: %d\n"
                      (length entries) (length protos)))
      (dolist (e (seq-take entries 3))
        (insert (format "  - %s\n" (nth 1 e))))
      (dolist (x (seq-take protos 3))
        (insert (format "  - %s\n" (nth 1 x)))))))
#+end_src
