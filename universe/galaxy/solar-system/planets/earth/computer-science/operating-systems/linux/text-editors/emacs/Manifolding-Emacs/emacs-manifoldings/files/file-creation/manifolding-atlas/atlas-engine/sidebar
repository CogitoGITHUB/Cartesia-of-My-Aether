Why: Implementation of ~manifolding-atlas-ui-sidebar-toggle~ — minimal functional sidebar without vui.
#+begin_src emacs-lisp
(defun manifolding-atlas-ui-sidebar-toggle ()
  "Toggle a minimal Atlas sidebar."
  (interactive)
  (let ((win (get-buffer-window "*Atlas Sidebar*")))
    (if win
        (delete-window win)
      (let ((buf (get-buffer-create "*Atlas Sidebar*")))
        (with-current-buffer buf
          (view-mode 1))
        (my/atlas-sidebar-refresh)))
        (display-buffer-in-side-window buf '((side . left) (window-width . 0.20)))))))

(defun manifolding-atlas-ui-sidebar-open ()
  "Open sidebar."
  (interactive)
  (manifolding-atlas-ui-sidebar-toggle))

(defun manifolding-atlas-ui-sidebar-close ()
  "Close sidebar."
  (interactive)
  (manifolding-atlas-ui-sidebar-toggle))
#+end_src

