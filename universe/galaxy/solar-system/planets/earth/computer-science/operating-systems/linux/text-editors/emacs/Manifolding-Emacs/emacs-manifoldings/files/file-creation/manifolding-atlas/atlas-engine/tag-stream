Chronological rereading stream for a tag (plus transitive children
when the hierarchy module is loaded).  Day-grouped title rows with
open buttons.  Order key is file modification time — documented
honestly: this is recency of edit, not a created-at the DB does not
store.  Read-only.  Nothing here runs at load.

** Stream
#+begin_src emacs-lisp
(require 'cl-lib)
(require 'seq)

(defun my/atlas-stream-tags (tag)
  "TAG plus transitive descendants when hierarchy is available."
  (if (and (fboundp 'my/atlas-tag-transitive)
           (boundp 'my/atlas-tag-extends)
           (> (hash-table-count my/atlas-tag-extends) 0))
      (my/atlas-tag-transitive tag)
    (list tag)))

(defun my/atlas-stream-notes (tag)
  "AIUs carrying TAG (transitive), newest file first."
  (let* ((tags (my/atlas-stream-tags tag))
         (notes (seq-filter
                 (lambda (n)
                   (seq-intersection
                    tags (ignore-errors (manifolding-atlas-note-tags n))))
                 (ignore-errors (manifolding-atlas-db-query)))))
    (sort (copy-sequence notes)
          (lambda (a b)
            (> (or (let ((p (ignore-errors (manifolding-atlas-note-path a))))
                     (and p (file-exists-p p)
                          (float-time (file-attribute-modification-time
                                       (file-attributes p)))))
                   0)
               (or (let ((p (ignore-errors (manifolding-atlas-note-path b))))
                     (when (and p (file-exists-p p))
                       (float-time (file-attribute-modification-time
                                    (file-attributes p)))))
                   0))))))

(defun my/atlas-stream-day (note)
  "Day string for AIU's file mtime."
  (let ((p (ignore-errors (manifolding-atlas-note-path note))))
    (if (and p (file-exists-p p))
        (format-time-string "%Y-%m-%d"
                            (file-attribute-modification-time
                             (file-attributes p)))
      "unknown")))

(defun my/atlas-stream-tag-choices ()
  "Completion candidates: census tags, else db tags."
  (if (fboundp 'my/atlas-tags-census)
      (mapcar #'car (ignore-errors (my/atlas-tags-census)))
    (let (out)
      (dolist (n (ignore-errors (manifolding-atlas-db-query)) out)
        (dolist (tag (ignore-errors (manifolding-atlas-note-tags n)))
          (when (and (stringp tag) (not (member tag out)))
            (push tag out)))))))

(defun my/atlas-stream (tag)
  "Show the chronological stream for TAG."
  (interactive
   (list (completing-read "Stream tag: " (my/atlas-stream-tag-choices))))
  (let ((buf (get-buffer-create "*Cyberdeck Stream*"))
        (notes (my/atlas-stream-notes tag))
        (day nil))
    (with-current-buffer buf
      (let ((inhibit-read-only t))
        (erase-buffer)
        (insert (format "Stream: %s (%d)\n\n" tag (length notes)))
        (dolist (n notes)
          (let ((note n) (d (my/atlas-stream-day n)))
            (unless (string= d day)
              (setq day d)
              (insert (format "\n== %s ==\n" day)))
            (insert-text-button
             (or (ignore-errors (manifolding-atlas-note-title note)) "?")
             'action (lambda (_) (ignore-errors (manifolding-atlas-visit note))))
            (insert "\n"))))
      (special-mode)
      (display-buffer buf))))
#+end_src
