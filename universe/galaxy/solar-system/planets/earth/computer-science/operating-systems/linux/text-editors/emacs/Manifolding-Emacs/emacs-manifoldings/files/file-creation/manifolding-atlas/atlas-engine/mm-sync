(defun my/mm-sync--row-of-title (map-file base title)
  "Line number of TITLE row at/after BASE, or nil."
  (with-current-buffer (find-file-noselect map-file)
    (save-excursion
      (goto-char (point-min))
      (forward-line base)
      (when (re-search-forward
