(defun my/mm-child-maps (map-file)
  "Map files exactly one directory level below MAP-FILE's own."
  (let ((mapdir (file-name-directory (directory-file-name map-file)))
        out)
    (dolist (m (my/mm-map-files))
      (let ((mdir (file-name-directory (directory-file-name m))))
        (when (and (not (equal m map-file))
                   (equal (file-name-directory (directory-file-name mdir))
                          mapdir))
          (push m out))))
    out))

(defun my/mm-sync-directives (map-file)
  "Ensure exactly one ⟦ MAP ⟧ directive per child map, ordered.
Directives live at the end of the region, sorted by child MM_ORDER."
  (when (and (fboundp 'org-mindmap-parser-parse-region)
             (file-exists-p map-file))
    (with-current-buffer (find-file-noselect map-file)
      (save-excursion
        (goto-char (point-min))
        (when (re-search-forward "^[ \t]*#\\+begin_mindmap\\b" nil t)
          (let* ((kids (sort (my/mm-child-maps map-file)
                             (lambda (a b)
                               (< (my/mm-map-order-of a)
                                  (my/mm-map-order-of b)))))
                 (want (mapcar (lambda (k)
                                 (format "#+wormhole: [[id:%s][\u27e6 MAP: %s \u27e7]] :level 2 :only-contents"
                                         (or (my/mm-file-id k) "?")
                                         (file-name-nondirectory
                                          (directory-file-name k))))
                               kids)))
          (my/mm-sync--drop-directives map-file)
          (my/mm-sync--insert-directives map-file want)))))))

(defun my/mm-sync--directive-lines (map-file)
  "Line numbers of wormhole directives inside the map region.
Other wormholes in the file belong to other business."
  (with-current-buffer (find-file-noselect map-file)
    (save-excursion
      (goto-char (point-min))
      (when (re-search-forward "^[ \t]*#\\+begin_mindmap\\b" nil t)
        (let ((rstart (line-number-at-pos))
              (rend nil)
              (gone nil))
          (when (re-search-forward "^[ \t]*#\\+end_mindmap\\b" nil t)
            (setq rend (line-number-at-pos)))
          (when rend
            (goto-char (point-min))
            (while (re-search-forward "^[ \t]*#\\+wormhole:.*$" nil t)
              (let ((ln (line-number-at-pos)))
                (when (and (> ln rstart) (< ln rend))
                  (push ln gone))))
            (nreverse gone)))))))

(defun my/mm-sync--drop-directives (map-file)
  "Delete region directive lines, bottom-up (no shifting)."
  (let ((lines (my/mm-sync--directive-lines map-file)))
    (when lines
      (with-current-buffer (find-file-noselect map-file)
        (let ((inhibit-read-only t))
          (dolist (ln (sort lines #'>))
            (goto-char (point-min))
            (forward-line (1- ln))
            (delete-region (line-beginning-position)
                           (min (point-max)
                                (1+ (line-end-position))))))))))

(defun my/mm-sync--insert-directives (map-file want)
  "Insert directive lines WANT before the region end marker."
  (when want
    (with-current-buffer (find-file-noselect map-file)
      (save-excursion
        (goto-char (point-min))
        (when (re-search-forward "^[ \t]*#\\+end_mindmap\\b" nil t)
          (forward-line 0)
          (let ((inhibit-read-only t))
            (dolist (line want)
              (insert line "\n"))))))))

(defun my/mm-map-order-of (map-file)
  "MM_ORDER float of MAP-FILE, huge when absent."
  (let ((o (my/mm-file-drawer-get map-file "MM_ORDER")))
    (if (and o (string-match-p "^-?[0-9.]+$" o))
        (string-to-number o)
      1e18)))

(defun my/mm-embed-format-strip-nested (_type content _values)
  "Drop inner wormhole directives from transcluded CONTENT."
  (mapconcat #'identity
             (cl-remove-if (lambda (l)
                             (string-match-p "^[ \t]*#\\+wormhole:" l))
                           (split-string content "\n"))
             "\n"))

(when (boundp 'atlas-wormholes-content-format-functions)
  (unless (member #'my/mm-embed-format-strip-nested
                  atlas-wormholes-content-format-functions)
    (push #'my/mm-embed-format-strip-nested
          atlas-wormholes-content-format-functions)))
