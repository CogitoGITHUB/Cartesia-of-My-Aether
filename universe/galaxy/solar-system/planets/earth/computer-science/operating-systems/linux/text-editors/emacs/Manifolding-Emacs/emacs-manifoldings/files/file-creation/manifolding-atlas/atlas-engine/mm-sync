(defun my/mm-sync--anchor-line (map-file title desired)
  "Line number to insert after, or nil for region top."
  (let ((pos (cl-position title desired
                          :key (lambda (d) (nth 2 d))
                          :test #'equal))
        (base (my/mm-sync--region-base map-file)))
    (when (and pos base)
      (cl-loop for i from (1- pos) downto 0
               for ln = (my/mm-sync--row-of-title
                         map-file base (nth 2 (nth i desired)))
               when ln return ln))))

(defun my/mm-sync--region-top (map-file fn)
