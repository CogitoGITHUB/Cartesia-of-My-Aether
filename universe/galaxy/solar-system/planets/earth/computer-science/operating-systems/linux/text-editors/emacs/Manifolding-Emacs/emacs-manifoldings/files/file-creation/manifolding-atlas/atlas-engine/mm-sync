  (with-current-buffer (find-file-noselect map-file)
    (save-excursion
      (goto-char (point-min))
      (when (re-search-forward "^[ \t]*#\\+begin_mindmap\\b" nil t)
        (forward-line 1)
        (let ((inhibit-read-only t))
          (funcall fn))))))

(defun my/mm-sync--insert-title (map-file title desired)
  "Insert TITLE row after the previous desired sibling that has a row."
  (let ((anchor (my/mm-sync--anchor-line map-file title desired)))
    (with-current-buffer (find-file-noselect map-file)
      (save-excursion
        (let ((inhibit-read-only t))
          (if anchor
              (progn
                (goto-char (point-min))
                (forward-line anchor)
                (insert title "\n"))
            (my/mm-sync--region-top
             map-file
             (lambda () (insert title "\n")))))))))
