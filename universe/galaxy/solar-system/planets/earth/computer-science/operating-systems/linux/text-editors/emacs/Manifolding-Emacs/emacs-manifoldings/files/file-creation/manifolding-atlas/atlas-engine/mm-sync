** Structural sync (vendor-op rebuild)
Bare title rows are NOT structure: the vendor parser reads them as
continuation text and the next align would merge them away (proven:
insert "B" under bare "A", align, region collapses to one node).
So structural change rebuilds through the vendor ops instead: drop
directives (they would confuse the parse; reconciled after),
wipe the region, insert-root the map title, then insert each
member title as a sibling anchored on the root. Sibling-on-root
delegates to insert-child, which APPENDS, so call order equals
MM_ORDER exactly with no anchor matching at all. Failure modes
degrade to parseable states (empty or partial region); the next
sync retries. Never throws.
#+begin_src emacs-lisp
(defun my/mm-sync--rebuild (map-file desired map-title)
  "Rebuild MAP-FILE's region: root MAP-TITLE, children DESIRED
titles in order, via the vendor insert ops. Returns t on success."
  (condition-case nil
      (with-current-buffer (find-file-noselect map-file)
        (my/mm-sync--drop-directives map-file)
        (save-excursion
          (goto-char (point-min))
          (when (re-search-forward "^[ \t]*#\\+begin_mindmap\\b" nil t)
            (let ((inhibit-read-only t))
              (forward-line 1)
              (let ((content-start (point)))
                (when (re-search-forward "^[ \t]*#\\+end_mindmap\\b"
                                         nil t)
                  (delete-region content-start
                                 (line-beginning-position)))))
            ;; Empty region: insert-root is the supported entry
            ;; (get-state parses zero roots and allows it).
            (goto-char (point-min))
            (when (re-search-forward "^[ \t]*#\\+begin_mindmap\\b" nil t)
              (forward-line 1)
              (let ((org-mindmap-confirm-delete nil))
                (org-mindmap-insert-root map-title))
              (dolist (d desired)
                (my/mm-sync--append-child map-file (nth 2 d))))
            ;; Normalize through the proven-safe align path.
            (goto-char (point-min))
            (when (re-search-forward "^[ \t]*#\\+begin_mindmap\\b" nil t)
              (forward-line 1)
              (condition-case nil
                  (org-mindmap-align)
                (error nil)))
            t)))
    (error nil)))

(defun my/mm-sync--append-child (map-file title)
  "Insert TITLE as a new last child of MAP-FILE's root node.
Re-parses per call, so earlier inserts shifting layout can never
mis-anchor, and duplicate-looking titles cannot collide: the
anchor is the parent-less node, never a text search."
  (let ((rows (my/mm-sync-region-rows map-file))
        (root nil))
    (dolist (r rows)
      (unless (nth 4 r)
        (setq root r)))
    (when root
      (with-current-buffer (find-file-noselect map-file)
        (save-excursion
          (goto-char (point-min))
          (when (re-search-forward "^[ \t]*#\\+begin_mindmap\\b" nil t)
            (forward-line (1+ (nth 0 root)))
            (move-to-column (nth 1 root))
            (let ((org-mindmap-confirm-delete nil))
              (condition-case nil
                  (org-mindmap-insert-sibling title)
                (error nil)))))))))
#+end_src

