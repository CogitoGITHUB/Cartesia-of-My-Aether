(defvar my/mm--syncing nil
  "Re-entrancy guard: bound t while a sync writes.")

(defun my/mm-vault-file-p (file)
  "Non-nil when FILE is a syncable vault note (extensionless, tracked)."
  (and file (stringp file)
       (let ((root (and (fboundp 'my/manifolding-atlas-root-dir)
                        (ignore-errors (my/manifolding-atlas-root-dir)))))
         (and root
              (string-prefix-p (file-name-as-directory root)
                               (expand-file-name file))
              (not (string-match-p "/\\.git/" file))
              (not (string-match-p "/WIP/" file))
              (not (string-match-p "/admin/" file))
              (null (file-name-extension file))
              (file-regular-p file)))))

(defun my/mm-sync-headings (file)
  "Alist (ID . TITLE) for all headlines in FILE. ID may be nil."
  (when (file-exists-p file)
    (with-temp-buffer
      (insert-file-contents file)
      ;; Real org-mode, hooks delayed (see `my/mm-file-drawer-get').
      (let ((delay-mode-hooks t)) (org-mode))
      (let (out)
        (org-element-map (org-element-parse-buffer) 'headline
          (lambda (h)
            (push (cons (org-element-property :ID h)
                        (org-element-property :raw-value h))
                  out)))
        (nreverse out)))))

(defun my/mm-sync-file-title (file)
  "Display title of FILE: first headline, else basename."
  (or (cdr (car (my/mm-sync-headings file)))
      (file-name-nondirectory (directory-file-name file))))

(defun my/mm-sync-node-text (file)
  "Card text for FILE: MM_ANCHOR headline, else file title."
  (let ((anchor (my/mm-file-drawer-get file "MM_ANCHOR")))
    (if (and anchor (not (string-empty-p anchor)))
        (or (cdr (assoc anchor (my/mm-sync-headings file)))
            (my/mm-sync-file-title file))
      (my/mm-sync-file-title file))))

(defun my/mm-sync-members (map-file)
  "Ordered member list for MAP-FILE: ((ID FILE TITLE ORDER)).
Non-map files with explicit MM_MAP = map id, plus same-directory
files falling back to it by the default rule. Sorted by MM_ORDER."
  (let ((map-id (my/mm-file-id map-file))
        (mapdir (file-name-directory (directory-file-name map-file)))
        out)
    (dolist (f (and (file-directory-p mapdir)
                    (directory-files mapdir t "^[^.]")))
      (when (and (file-regular-p f)
                 (null (file-name-extension f))
                 (not (equal (my/mm-file-drawer-get f "MM_KIND") "map")))
        (let ((mid (my/mm-file-drawer-get f "MM_MAP")))
          (when (or (and mid (equal mid map-id))
                    (and (null mid)
                         (equal (my/mm-default-map f) map-file)))
            (let ((id (my/mm-file-id f)))
              (when id
                (push (list id f (my/mm-sync-node-text f)
                            (let ((o (my/mm-file-drawer-get f "MM_ORDER")))
                              (if (and o (string-match-p "^-?[0-9.]+$" o))
                                  (string-to-number o)
                                1e18)))
                      out)))))))
    (sort out (lambda (a b) (< (nth 3 a) (nth 3 b))))))

(defun my/mm-sync-region-rows (map-file)
  "Node rows of MAP-FILE's mindmap region.
Each entry: (ROW COL WIDTH TEXT HAD-PARENT). The parent flag lets
text sync partition the structural root (map title) from member
rows without touching vendor node objects."
  (when (and (fboundp 'org-mindmap-parser-parse-region)
             (fboundp 'org-mindmap-parser-node-text)
             (fboundp 'org-mindmap-parser-node-parent))
    (with-current-buffer (find-file-noselect map-file)
      (save-excursion
        (goto-char (point-min))
        (when (re-search-forward "^[ \t]*#\\+begin_mindmap\\b" nil t)
          (forward-line 1)
          (let ((roots (ignore-errors (org-mindmap-parser-parse-region)))
                rows)
            (dolist (r (or roots '()))
              (setq rows (my/mm-sync--collect-rows r rows)))
            (nreverse rows)))))))

(defun my/mm-sync--collect-rows (node acc)
  "Push (ROW COL WIDTH TEXT HAD-PARENT) for NODE and descendants."
  (when (fboundp 'org-mindmap-parser-node-text)
    (push (list (org-mindmap-parser-node-row node)
                (org-mindmap-parser-node-col node)
                (org-mindmap-parser-node-width node)
                (org-mindmap-parser-node-text node)
                (not (null (and (fboundp 'org-mindmap-parser-node-parent)
                                (org-mindmap-parser-node-parent node)))))
          acc)
    (dolist (c (org-mindmap-parser-node-children node))
      (setq acc (my/mm-sync--collect-rows c acc))))
  acc)

(defun my/mm-node-live-p (id)
  "Non-nil when ID still exists in mm_nodes. Missing mm = no writes."
  (and (fboundp 'mm/node-at)
       (condition-case nil
           (not (null (mm/node-at id)))
         (error nil))))

(defun my/mm-sync-directive-line-p (text)
  "Non-nil when TEXT is an org keyword line (e.g. a wormhole directive).
Such rows are never member nodes: sync neither matches, substitutes,
nor deletes them."
  (and (stringp text)
       (string-match-p "^[ \t]*#\\+" text)))

(defun my/mm-sync--base-text (text)
  "Row TEXT without a glued wormhole-directive tail.
The vendor parser glues region directive lines into the last node
as continuation text (proven: last child parses as \"C #+wormhole:
...\"); matching compares the base title while positions still
address the node's own span, so the directive line is never
touched by substitution."
  (if (and (stringp text)
           (string-match " #\\+wormhole:" text))
      (substring text 0 (match-beginning 0))
    text))

(defun my/mm-sync--diff (map-file)
  "Pure diff of MAP-FILE: (ADDED REMOVED ROOT-OK SUBS). Writes nothing.
ADDED is member ids with no row, REMOVED leftover rows, ROOT-OK
non-nil when exactly one parent-less row holds the map title,
SUBS ((ROW COL WIDTH TITLE)) fitting in-place renames. The vendor
registry (mm_nodes) is ephemeral per session, so a missing id only
routes a pair to the structural path; files stay source of truth
and the rebuild renders every title fresh anyway. Never throws."
  (condition-case nil
      (let* ((desired (my/mm-sync-members map-file))
             (map-title (my/mm-sync-file-title map-file))
             (all-rows (cl-remove-if
                        (lambda (r)
                          (my/mm-sync-directive-line-p (nth 3 r)))
                        (my/mm-sync-region-rows map-file)))
             (roots (cl-remove-if (lambda (r) (nth 4 r)) all-rows))
             (mrows (cl-remove-if-not (lambda (r) (nth 4 r)) all-rows))
             (root-ok (and (= (length roots) 1)
                           (equal (my/mm-sync--base-text
                                   (nth 3 (car roots)))
                                  map-title)))
             added removed subs)
        (when (and desired mrows)
          ;; Pass 1: exact text matches pair up for free.
          (let ((rd mrows)
                (dd desired))
            (dolist (d dd)
              (let ((hit (cl-find (nth 2 d) rd
                                  :key (lambda (r)
                                         (my/mm-sync--base-text (nth 3 r)))
                                  :test #'equal)))
                (when hit
                  (setq rd (delq hit rd))
                  (setq dd (delq d dd)))))
            ;; Pass 2: leftovers zip in order; fitting titles become
            ;; SUBS, no-fit pairs split to added/removed.
            (let (added-ids removed-rows sub-list)
              (while (and dd rd)
                (let* ((d (pop dd))
                       (r (pop rd))
                       (id (nth 0 d))
                       (title (nth 2 d))
                       (old (my/mm-sync--base-text (nth 3 r))))
                  (cond ((equal title old) nil)
                        ((and (<= (string-width title) (nth 2 r))
                              (my/mm-node-live-p id))
                         (push (list (nth 0 r) (nth 1 r)
                                     (nth 2 r) title)
                               sub-list))
                        (t
                         (push id added-ids)
                         (push r removed-rows)))))
              ;; Leftover desired ids are added, leftover rows removed.
              ;; Leftover rows match no live member title: vanished
              ;; nodes (directive lines never reach here: filtered).
              (setq removed (nconc removed-rows
                                   (mapcar (lambda (r) r) rd)))
              (setq added (nconc added-ids
                                 (mapcar (lambda (d) (nth 0 d)) dd)))
              (setq subs (nreverse sub-list)))))
        ;; With an empty region every desired id is added
        ;; (and root-ok is nil, so the rebuild path runs).
        (when (and desired (null mrows))
          (setq added (mapcar (lambda (d) (nth 0 d)) desired)))
        ;; With no members every member row is removed; a lone
        ;; correct root stays untouched.
        (when (null desired)
          (setq removed mrows))
        (list added removed root-ok subs))
    (error (list nil nil nil nil))))

(defun my/mm-sync--apply-text (map-file subs)
  "Perform SUBS in-place title substitutions on MAP-FILE.
Same-width replacement shifts nothing, so positions from the diff
stay valid. Returns t when anything changed. Never throws."
  (condition-case nil
      (let ((changed nil))
        (dolist (s subs)
          (my/mm-sync--replace-row-text
           map-file (nth 0 s) (nth 1 s) (nth 2 s) (nth 3 s))
          (setq changed t))
        changed)
    (error nil)))

(defun my/mm-sync--replace-row-text (map-file row col width title)
  "Replace the title at (ROW COL) of MAP-FILE's region with TITLE.
Deletion clamps to end-of-line: vendor node WIDTH counts visual
padding the buffer never stores (lines are trimmed), and deleting
past EOL would eat the newline and glue two rows together (proven
in testing: same-width rename merged the child lines into one).
No re-padding: parse widths recompute from content each sync, and
the next structural rebuild re-renders everything anyway."
  (with-current-buffer (find-file-noselect map-file)
    (save-excursion
      (goto-char (point-min))
      (when (re-search-forward "^[ \t]*#\\+begin_mindmap\\b" nil t)
        (forward-line (1+ row))
        (move-to-column col)
        (let ((inhibit-read-only t))
          (delete-region (point)
                         (min (+ (point) width) (line-end-position)))
          (insert title))))))

(defun my/mm-sync-map (map-file)
  "Full sync of MAP-FILE: rename-only titles apply in place,
anything structural (added/removed members, missing or wrong
root) rebuilds the region through the vendor ops, then child-map
directives reconcile and the buffer saves. Never throws."
  (when (and (not my/mm--syncing) (file-exists-p map-file))
    (let ((my/mm--syncing t))
      (condition-case nil
          (let* ((diff (my/mm-sync--diff map-file))
                 (added (nth 0 diff))
                 (removed (nth 1 diff))
                 (root-ok (nth 2 diff))
                 (subs (nth 3 diff)))
            (if (or added removed (not root-ok))
                (my/mm-sync--rebuild
                 map-file
                 (my/mm-sync-members map-file)
                 (my/mm-sync-file-title map-file))
              (when subs
                (my/mm-sync--apply-text map-file subs)))
            (my/mm-sync-directives map-file)
            (with-current-buffer (find-file-noselect map-file)
              (when (buffer-modified-p)
                (save-buffer))))
        (error nil)))))

(defun my/mm-sync-on-save ()
  "after-save entry: sync the map owning the saved file."
  (when (and (not my/mm--syncing)
             buffer-file-name
             (my/mm-vault-file-p buffer-file-name))
    (let ((my/mm--syncing t))
      (cond ((equal (my/mm-file-drawer-get buffer-file-name "MM_KIND") "map")
             (my/mm-sync-map buffer-file-name))
            (t
             (let ((m (my/mm-primary-map buffer-file-name)))
               (when (and m (file-exists-p m))
                 (my/mm-sync-map m))))))))

(unless (member #'my/mm-sync-on-save after-save-hook)
  (add-hook 'after-save-hook #'my/mm-sync-on-save))
