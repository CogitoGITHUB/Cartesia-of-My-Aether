(defvar my/mm--map-cache nil
  "Cached list of map files (absolute paths). Refresh on creation.")

(defvar my/mm--default-warned-files nil
  "Files already warned about default-map fallback this session.")

(defun my/mm-file-drawer-get (file key)
  "Drawer KEY from FILE's first headline, or nil."
  (when (and file (file-exists-p file))
    (with-temp-buffer
      (insert-file-contents file)
      (delay-mode-hooks (org-mode))
      (goto-char (point-min))
      (when (re-search-forward org-heading-regexp nil t)
        (org-entry-get (point) key)))))

(defun my/mm-file-id (file)
  "Note id of FILE from its drawer."
  (my/mm-file-drawer-get file "ID"))

(defun my/mm-refresh-maps ()
  "Rebuild the map-file cache. Returns the list."
  (setq my/mm--map-cache nil)
  (when (fboundp 'my/manifolding-atlas-root-dir)
    (let ((root (ignore-errors (my/manifolding-atlas-root-dir))))
      (when (and root (file-directory-p root))
        (dolist (f (directory-files-recursively root "[^./]+$"))
          (when (and (file-regular-p f)
                     (not (string-match-p "/\\.git/" f))
                     (not (string-match-p "/WIP/" f))
                     (equal (my/mm-file-drawer-get f "MM_KIND") "map"))
            (push f my/mm--map-cache))))))
  my/mm--map-cache)

(defun my/mm-map-files ()
  "List of map files, cached per boot."
  (or my/mm--map-cache
      (my/mm-refresh-maps)))

(defun my/mm-default-map (file)
  "Nearest ancestor directory of FILE containing a map file.
Documented fallback when FILE has no explicit MM_MAP. Logs a soft
warning once per file per session so missing MM_MAP gets noticed."
  (let* ((dir (file-name-directory (directory-file-name
                                    (expand-file-name file))))
         (best nil)
         (best-len -1))
    (dolist (m (my/mm-map-files))
      (let ((mdir (file-name-directory (directory-file-name m))))
        (when (and (string-prefix-p mdir dir)
                   (> (length mdir) best-len))
          (setq best m best-len (length mdir)))))
    (when (and best (not (member file my/mm--default-warned-files)))
      (push file my/mm--default-warned-files)
      (display-warning 'manifolding-atlas
                       (format "No explicit MM_MAP on %s; using nearest map %s"
                               (file-name-nondirectory file)
                               (file-name-nondirectory best))
                       :warning))
    best))

(defun my/mm-primary-map (file)
  "Primary map file for FILE: explicit MM_MAP drawer id resolved to
path, else the documented default-map fallback."
  (let ((id (my/mm-file-drawer-get file "MM_MAP")))
    (if (and id (not (string-empty-p id)))
        (or (my/mm-map-file-by-id id)
            (my/mm-default-map file))
      (my/mm-default-map file))))

(defun my/mm-map-file-by-id (id)
  "Map file whose drawer ID is ID, or nil."
  (cl-find-if (lambda (f) (equal (my/mm-file-id f) id))
              (my/mm-map-files)))

(defun my/mm-validate-map-dir (dir)
  "Signal an error if DIR already holds a mind-map file.
Enforces: no two map files in one directory."
  (let ((found (cl-remove-if-not
                (lambda (f)
                  (equal (file-name-directory (directory-file-name f))
                         (file-name-directory (directory-file-name
                                               (expand-file-name dir)))))
                (my/mm-map-files))))
    (when found
      (error "Directory already has a mind-map file: %s"
             (file-name-nondirectory (car found))))))
#+end_src

(defun my/mm-set-drawer (file key val)
  "Set drawer KEY to VAL on FILE's first headline. Never throws."
  (condition-case nil
      (with-current-buffer (find-file-noselect file)
        (save-excursion
          (goto-char (point-min))
          (when (re-search-forward org-heading-regexp nil t)
            (org-entry-put (point) key val))
          (save-buffer)))
    (error nil)))

(defun my/mm-set-map-membership (file map-id &optional anchor-id parent-id order)
  "Stamp map membership drawers on FILE: MM_MAP plus optional
MM_ANCHOR, MM_PARENT, MM_ORDER. Never throws."
  (condition-case nil
      (progn
        (my/mm-set-drawer file "MM_MAP" map-id)
        (when anchor-id
          (my/mm-set-drawer file "MM_ANCHOR" anchor-id))
        (when parent-id
          (my/mm-set-drawer file "MM_PARENT" parent-id))
        (when order
          (my/mm-set-drawer file "MM_ORDER" (number-to-string order))))
    (error nil)))

(defun my/mm-assign-map (map-id note)
  "Post-apply: validate MAP-ID exists and refresh the map cache."
  (condition-case nil
      (when (and (stringp map-id) (my/mm-map-file-by-id map-id))
        (my/mm-refresh-maps))
    (error nil)))

** Text sync (in-place rows)
Parse the map region, match rows to declared member files, and
substitute title text in place (same width or narrower, padded).
Re-validates every id in mm_nodes before writing: a file deleted
between parse and write leaves no ghost row. Returns structural
diffs (added/removed ids) for the structural phase. Never throws.
#+begin_src emacs-lisp
(defvar my/mm--syncing nil
  "Re-entrancy guard: bound t while a sync writes.")

(defun my/mm-vault-file-p (file)
  "Non-nil when FILE is a syncable vault note (extensionless, tracked)."
  (and file (stringp file)
       (let ((root (and (fboundp 'my/manifolding-atlas-root-dir)
                        (ignore-errors (my/manifolding-atlas-root-dir)))))
         (and root
              (string-prefix-p (file-name-as-directory root)
                               (expand-file-name file))
              (not (string-match-p "/\\.git/" file))
              (not (string-match-p "/WIP/" file))
              (not (string-match-p "/admin/" file))
              (null (file-name-extension file))
              (file-regular-p file)))))

(defun my/mm-sync-headings (file)
  "Alist (ID . TITLE) for all headlines in FILE. ID may be nil."
  (when (file-exists-p file)
    (with-temp-buffer
      (insert-file-contents file)
      (delay-mode-hooks (org-mode))
      (let (out)
        (org-element-map (org-element-parse-buffer) 'headline
          (lambda (h)
            (push (cons (org-element-property :ID h)
                        (org-element-property :raw-value h))
                  out)))
        (nreverse out)))))

(defun my/mm-sync-file-title (file)
  "Display title of FILE: first headline, else basename."
  (or (cdr (car (my/mm-sync-headings file)))
      (file-name-nondirectory (directory-file-name file))))

(defun my/mm-sync-node-text (file)
  "Card text for FILE: MM_ANCHOR headline, else file title."
  (let ((anchor (my/mm-file-drawer-get file "MM_ANCHOR")))
    (if (and anchor (not (string-empty-p anchor)))
        (or (cdr (assoc anchor (my/mm-sync-headings file)))
            (my/mm-sync-file-title file))
      (my/mm-sync-file-title file))))

(defun my/mm-sync-members (map-file)
  "Ordered member list for MAP-FILE: ((ID FILE TITLE ORDER)).
Non-map files with explicit MM_MAP = map id, plus same-directory
files falling back to it by the default rule. Sorted by MM_ORDER."
  (let ((map-id (my/mm-file-id map-file))
        (mapdir (file-name-directory (directory-file-name map-file)))
        out)
    (dolist (f (and (file-directory-p mapdir)
                    (directory-files mapdir t "^[^.]")))
      (when (and (file-regular-p f)
                 (null (file-name-extension f))
                 (not (equal (my/mm-file-drawer-get f "MM_KIND") "map")))
        (let ((mid (my/mm-file-drawer-get f "MM_MAP")))
          (when (or (and mid (equal mid map-id))
                    (and (null mid)
                         (equal (my/mm-default-map f) map-file)))
            (let ((id (my/mm-file-id f)))
              (when id
                (push (list id f (my/mm-sync-node-text f)
                            (let ((o (my/mm-file-drawer-get f "MM_ORDER")))
                              (if (and o (string-match-p "^-?[0-9.]+$" o))
                                  (string-to-number o)
                                1e18)))
                      out)))))))
    (sort out (lambda (a b) (< (nth 3 a) (nth 3 b))))))

(defun my/mm-sync-region-rows (map-file)
  "Node rows of MAP-FILE's mindmap region: ((ROW COL WIDTH TEXT))."
  (when (and (fboundp 'org-mindmap-parser-parse-region)
             (fboundp 'org-mindmap-parser-node-text))
    (with-current-buffer (find-file-noselect map-file)
      (save-excursion
        (goto-char (point-min))
        (when (re-search-forward "^[ \t]*#\\+begin_mindmap\\b" nil t)
          (forward-line 1)
          (let ((roots (ignore-errors (org-mindmap-parser-parse-region)))
                rows)
            (dolist (r (or roots '()))
              (my/mm-sync--collect-rows r rows))
            (nreverse rows)))))))

(defun my/mm-sync--collect-rows (node acc)
  "Push (ROW COL WIDTH TEXT) for NODE and descendants onto ACC."
  (when (fboundp 'org-mindmap-parser-node-text)
    (push (list (org-mindmap-parser-node-row node)
                (org-mindmap-parser-node-col node)
                (org-mindmap-parser-node-width node)
                (org-mindmap-parser-node-text node))
          acc)
    (dolist (c (org-mindmap-parser-node-children node))
      (setq acc (my/mm-sync--collect-rows c acc))))
  acc)

(defun my/mm-node-live-p (id)
  "Non-nil when ID still exists in mm_nodes. Missing mm = no writes."
  (and (fboundp 'mm/node-at)
       (condition-case nil
           (not (null (mm/node-at id)))
         (error nil))))

(defun my/mm-sync-directive-line-p (text)
  "Non-nil when TEXT is an org keyword line (e.g. a wormhole directive).
Such rows are never member nodes: sync neither matches, substitutes,
nor deletes them."
  (and (stringp text)
       (string-match-p "^[ \t]*#\\+" text)))

(defun my/mm-sync-text (map-file)
  "In-place title sync of MAP-FILE. Returns (ADDED . REMOVED) id lists.
Text match first, order zip second, width-fit gate third,
mm_nodes revalidation fourth. Never throws."
  (condition-case nil
      (let ((desired (my/mm-sync-members map-file))
            (rows (cl-remove-if (lambda (r)
                                  (my/mm-sync-directive-line-p (nth 3 r)))
                                (my/mm-sync-region-rows map-file)))
            (added nil)
            (removed nil))
        (when (and desired rows)
          ;; Pass 1: exact text matches pair up for free.
          (let ((rd rows)
                (dd desired))
            (dolist (d dd)
              (let ((hit (cl-find (nth 2 d) rd
                                  :key (lambda (r) (nth 3 r))
                                  :test #'equal)))
                (when hit
                  (setq rd (delq hit rd))
                  (setq dd (delq d dd)))))
            ;; Pass 2: leftovers zip in order; substitute fitting titles.
            (while (and dd rd)
              (let* ((d (pop dd))
                     (r (pop rd))
                     (id (nth 0 d))
                     (title (nth 2 d))
                     (old (nth 3 r)))
                (when (and (not (equal title old))
                           (<= (string-width title) (nth 2 r))
                           (my/mm-node-live-p id))
                  (my/mm-sync--replace-row-text
                   map-file (nth 0 r) (nth 1 r) (nth 2 r) title))))
            ;; Leftovers are structural business.
            (setq removed (mapcar (lambda (r) r) rd))
            (setq added (mapcar (lambda (d) (nth 0 d)) dd))))
        (cons added removed))
    (error (cons nil nil))))

(defun my/mm-sync--replace-row-text (map-file row col width title)
  "Replace WIDTH chars at (ROW COL) of MAP-FILE's region with TITLE padded."
  (with-current-buffer (find-file-noselect map-file)
    (save-excursion
      (goto-char (point-min))
      (when (re-search-forward "^[ \t]*#\\+begin_mindmap\\b" nil t)
        (forward-line (1+ row))
        (move-to-column col)
        (let ((inhibit-read-only t))
          (delete-region (point) (+ (point) width))
          (insert title)
          (when (< (string-width title) width)
            (insert (make-string (- width (string-width title)) ?\s))))))))

(defun my/mm-sync-map (map-file)
  "Full sync of MAP-FILE: text, structural, directives, save."
  (when (and (not my/mm--syncing) (file-exists-p map-file))
    (let ((my/mm--syncing t))
      (condition-case nil
          (let* ((diffs (my/mm-sync-text map-file))
                 (added (car diffs))
                 (removed (cdr diffs)))
            (when (or added removed)
              (let ((desired (my/mm-sync-members map-file)))
                (my/mm-sync-structural map-file added removed desired)))
            (my/mm-sync-directives map-file)
            (with-current-buffer (find-file-noselect map-file)
              (when (buffer-modified-p)
                (save-buffer))))
        (error nil)))))

(defun my/mm-sync-on-save ()
  "after-save entry: sync the map owning the saved file."
  (when (and (not my/mm--syncing)
             buffer-file-name
             (my/mm-vault-file-p buffer-file-name))
    (let ((my/mm--syncing t))
      (cond ((equal (my/mm-file-drawer-get buffer-file-name "MM_KIND") "map")
             (my/mm-sync-map buffer-file-name))
            (t
             (let ((m (my/mm-primary-map buffer-file-name)))
               (when (and m (file-exists-p m))
                 (my/mm-sync-map m))))))))

(unless (member #'my/mm-sync-on-save after-save-hook)
  (add-hook 'after-save-hook #'my/mm-sync-on-save))
#+end_src

** Structural sync (insert at position + align)
New nodes get bare title rows at their declared slots; vanished
nodes lose their rows; then the existing align path re-layouts
(preserves text, moves rows). Runs inside my/mm-sync-map after text
sync, under the same re-entrancy guard. Never throws.
#+begin_src emacs-lisp
(defun my/mm-sync-structural (map-file added removed desired)
  "Apply structural diffs to MAP-FILE. ADDED is ids, REMOVED row
entries, DESIRED the ordered member list. Returns t when changed."
  (let ((changed nil))
    (when removed
      ;; Leftover rows match no live member title: vanished nodes.
      ;; The region is generated territory (annotate outside the
      ;; markers); directive lines never reach here (filtered).
      (with-current-buffer (find-file-noselect map-file)
        (save-excursion
          (goto-char (point-min))
          (when (re-search-forward "^[ \t]*#\\+begin_mindmap\\b" nil t)
            (let ((base (line-number-at-pos)))
              (dolist (r (sort (copy-sequence removed)
                               (lambda (a b) (> (nth 0 a) (nth 0 b)))))
                (goto-char (point-min))
                (forward-line (+ base 1 (nth 0 r)))
                (let ((inhibit-read-only t))
                  (delete-region (line-beginning-position)
                                 (min (point-max)
                                      (1+ (line-end-position)))))
                (setq changed t)))))))
    (when added
      (with-current-buffer (find-file-noselect map-file)
        (dolist (id added)
          (let ((tgt (cl-find id desired :key #'car :test #'equal)))
            (when (and tgt (my/mm-node-live-p id))
              (my/mm-sync--insert-title map-file (nth 2 tgt) desired)
              (setq changed t))))))
    (when (and changed (fboundp 'org-mindmap-align))
      (with-current-buffer (find-file-noselect map-file)
        (save-excursion
          (goto-char (point-min))
          (when (re-search-forward "^[ \t]*#\\+begin_mindmap\\b" nil t)
            (forward-line 1)
            (condition-case nil
                (org-mindmap-align)
              (error nil))))))
    changed)

(defun my/mm-sync--region-base (map-file)
