(defun my/manifolding-atlas-emacs-mechanism--open-capture (note body)
  "Open org-capture for NOTE's body with BODY template."
  (let ((org-capture-templates
         `(("v" "Edit mechanism body"
            plain (file+function ,(manifolding-atlas-note-path note)
                   (lambda () (goto-char (point-max))))
            ,body :kill-buffer t :unnarrowed t))))
    (org-capture nil "v")))
#+end_src

** Create command
#+begin_src emacs-lisp
(defun my/manifolding-atlas-emacs-mechanism-local-create (title)
  "Create a local mechanism note for TITLE in the mechanism subdir."
  (interactive (list (read-string "Mechanism file title: ")))
  (make-directory my/manifolding-atlas-emacs-mechanism-directory t)
  (let* ((slug (downcase (replace-regexp-in-string "[^a-z0-9]+" "-" title)))
         (body (my/manifolding-atlas-emacs-mechanism--template-body
                "emacs-mechanism-local"))
         (note (manifolding-atlas-create title (concat "emacs-mechanism/" slug)
                 :tags '("emacs-mechanism") :body body)))
    (my/manifolding-atlas-emacs-mechanism--store-template
     note "emacs-mechanism-local")
    (my/manifolding-atlas-emacs-mechanism--ensure-headline-tag note)
    (my/manifolding-atlas-emacs-mechanism--open-capture note body)
    note))
#+end_src
