(defun my/manifolding-atlas-emacs-mechanism--template-body (kind)
  "Body text for KIND template file, or \"%?\"."
  (let ((file (expand-file-name kind (my/capture-directory))))
    (if (file-exists-p file)
        (with-temp-buffer
          (insert-file-contents file)
          (buffer-string))
      "%?")))
