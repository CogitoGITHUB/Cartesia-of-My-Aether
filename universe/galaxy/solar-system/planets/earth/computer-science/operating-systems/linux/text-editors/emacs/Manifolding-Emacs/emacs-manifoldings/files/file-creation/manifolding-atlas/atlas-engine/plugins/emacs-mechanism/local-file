(defun my/manifolding-atlas-emacs-mechanism--store-template (note kind)
  "Stamp TEMPLATE + TEMPLATE_HASH unfoldings on NOTE."
  (my/manifolding-atlas--unfolding-put note "TEMPLATE" kind)
  (my/manifolding-atlas--unfolding-put note "TEMPLATE_HASH"
    (or (ignore-errors (my/manifolding-atlas--capture-file-hash kind))
        "unknown")))
