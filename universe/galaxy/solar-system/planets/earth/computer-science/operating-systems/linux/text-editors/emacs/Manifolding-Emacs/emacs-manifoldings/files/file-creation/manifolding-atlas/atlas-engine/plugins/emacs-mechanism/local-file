** Headline tag
#+begin_src emacs-lisp
(defun my/manifolding-atlas-emacs-mechanism--ensure-headline-tag (note)
  "Ensure NOTE's first headline has :ID: and :EMACS_MECHANISM: tag."
  (let ((path (manifolding-atlas-note-path note)))
    (with-current-buffer (find-file-noselect path)
      (goto-char (point-min))
      (when (re-search-forward "^\\*+ " nil t)
        (unless (org-id-get) (org-id-get-create))
        (let ((tags (org-get-tags)))
          (unless (member "EMACS_MECHANISM" tags)
            (org-set-tags (cons "EMACS_MECHANISM" tags)))))
      (save-buffer))))
#+end_src

** Body capture opener
